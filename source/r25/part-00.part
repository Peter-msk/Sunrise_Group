@media(prefers-reduced-motion:reduce){*,*::before,*::after{transition:none!important;scroll-behavior:auto!important;animation:none!important}}
/* Final composition calibration from the first render. */
@media(min-width:761px){.r19-cinema{padding-top:32px;padding-bottom:24px;grid-template-rows:auto auto auto;align-content:space-between}.r19-cinema h1{font-size:clamp(74px,9.8vw,148px);letter-spacing:-.072em;line-height:.94}.r19-cinema-world .sg3-scene canvas{width:min(100%,calc((100svh - 320px)*1.5),1000px);min-width:460px;margin:-36px auto -45px}.r19-cinema-world figcaption{bottom:2px}.r11-legend{bottom:10px}.r19-cinema-bottom{padding-top:16px}.r10-home-copy{gap:8px 26px}.r07-home-lead{font-size:clamp(22px,2.2vw,32px)}.home-actions .primary-action{min-height:36px}.r19-product-gallery .inner-hero{padding-top:48px;padding-bottom:46px}.r19-showcase-art img{max-height:325px}.r19-atlas .inner-hero{padding-top:20px;padding-bottom:20px}.r19-atlas-art img{max-height:390px}}
@media(max-width:760px){.r19-cinema h1{letter-spacing:-.055em}.r19-cinema-world .sg3-scene canvas{width:100%;margin:0 auto}.r19-cinema-world figcaption{padding-left:0;padding-right:0}.r19-cinema-world .r11-legend{margin-bottom:17px}.r19-proof-hero .sg3-hero-copy>.project-quick{grid-template-columns:1fr 1fr;gap:10px 16px}.r19-proof-hero .project-quick>div{border-bottom:0}.r19-proof-hero .project-quick>div:nth-child(2){grid-column:1/-1;grid-row:2}.r19-proof-hero .project-quick>div:nth-child(3){grid-column:2;grid-row:1}.r19-proof-hero .project-quick strong{font-size:15px}}
.future-grid article>span{display:inline-block}.r19-cinema a:hover,body:has(#page-outlet[data-route="/"]) .site-header a:hover{color:#f3bf94}.r19-cinema .r07-scroll:focus-visible,.r19-cinema .primary-action:focus-visible{outline-color:#f3bf94}
@media(min-width:761px){.r19-cinema-world .sg3-scene canvas{width:min(100%,calc((100svh - 350px)*1.5),980px);margin:-36px auto -15px}.r19-cinema-world figcaption{bottom:8px}.r11-legend{bottom:14px}}

/* R20 — product art direction and compact catalogue. Scope: product and catalogue pages. */
.sg3-product[data-design-family]{--product-ink:#182c27;--product-accent:#386455;--product-paper:#f5f6f2;--product-line:#d5ddd5}
.sg3-product[data-design-family] .project-hero{margin:0 auto;max-width:var(--max);padding:clamp(26px,4vw,64px) var(--pad);gap:clamp(24px,3vw,48px);color:var(--product-ink);align-items:center}
.sg3-product[data-design-family] .project-hero h1{font-size:clamp(34px,4.15vw,64px);line-height:1.04;letter-spacing:-.045em;overflow-wrap:anywhere;max-width:20ch;font-weight:560}
.sg3-product[data-design-family] .project-hero .sg3-hero-copy{display:block;min-width:0}
.sg3-product[data-design-family] .project-hero .sg3-hero-copy>a{margin-bottom:8px;min-height:44px}
.sg3-product[data-design-family] .project-hero .sg3-hero-copy>p:not(.eyebrow){font-size:clamp(15px,1.4vw,19px);line-height:1.75;margin-top:15px;max-width:60ch}
.sg3-product[data-design-family] .r20-visual-stage{min-width:0;width:100%;margin:0;align-self:center}
.sg3-product[data-design-family] .r12-hero-proof{background:transparent;padding:0;gap:10px}
.sg3-product[data-design-family] .screen-full-link img{max-height:510px;object-fit:contain;width:100%;height:auto;box-shadow:0 8px 24px #182c271b}
.sg3-product[data-design-family] .project-quick{padding-top:20px;padding-bottom:20px;gap:0;border-bottom:1px solid var(--line)}
.sg3-product[data-design-family] .project-quick>div{padding:9px 20px}
.sg3-product[data-design-family] .project-quick>div:first-child{padding-left:0}
.sg3-product[data-design-family] .project-quick strong{font-size:16px}
.sg3-product[data-design-family] .r07-product-sections{justify-content:flex-start;padding-left:max(var(--pad),calc((100% - var(--max))/2 + var(--pad)));gap:8px 28px}
.sg3-product[data-design-family] .r20-feature-layout{gap:clamp(24px,4vw,64px);padding-top:38px;padding-bottom:46px}
.sg3-product[data-design-family] .r20-feature-layout h2{font-size:clamp(25px,2.6vw,38px);margin-bottom:16px}
.sg3-product[data-design-family] .r17-release{background:#f0f2ee;border-top:2px solid var(--product-accent);padding:23px}
.sg3-product[data-design-family] .r17-release h2{font-size:23px}
.sg3-product[data-design-family] .feature-list li{font-size:15px;padding:14px 0;line-height:1.6}
.sg3-product[data-design-family] .feature-list li span{font-family:inherit;font-size:13px;font-weight:650;letter-spacing:.04em;color:var(--product-accent)}
.sg3-product[data-design-family] .r19-workflow{padding-top:38px;padding-bottom:38px}
.sg3-product[data-design-family] .r19-workflow h2{font-size:clamp(28px,3vw,43px)}
/* B: document studio — actual work surface alongside copy, restrained neutral material */
.sg3-product[data-design-family="document"]{--product-accent:#805f47;--product-paper:#f1eee8}
.sg3-product[data-design-family="document"] .project-hero{display:grid;grid-template-columns:minmax(0,.75fr) minmax(0,1.25fr);align-items:center}
.sg3-product[data-design-family="document"] .r20-visual-stage{background:#eeeae3;padding:clamp(14px,2.2vw,28px)}
.sg3-product[data-design-family="document"] .r20-visual-stage.sg3-scene{background:#14252b;color:#f1f4ef;padding:0}
.sg3-product[data-design-family="document"] .r17-release{background:#f4f0e9}
/* B: utility workshop — strong product stage, screen proof presented on a neutral display surface */
.sg3-product[data-design-family="utility"]{--product-accent:#387082}
.sg3-product[data-design-family="utility"] .project-hero{max-width:none;background:#e8eff0;display:grid;grid-template-columns:minmax(0,.88fr) minmax(0,1.12fr);align-items:center;padding-left:max(var(--pad),calc((100% - var(--max))/2 + var(--pad)));padding-right:max(var(--pad),calc((100% - var(--max))/2 + var(--pad)))}
.sg3-product[data-design-family="utility"] .r20-visual-stage{background:#f7faf9;padding:18px;border:1px solid #c3d0d3}
.sg3-product[data-design-family="utility"] .r20-feature-layout{grid-template-columns:minmax(0,1.9fr) minmax(0,1fr)}
/* B: environmental workspace — overview, full-width work surface, balanced metadata strip */
.sg3-product[data-design-family="workspace"]{--product-accent:#406b79}
.sg3-product[data-design-family="workspace"] .project-hero{display:grid;grid-template-columns:minmax(0,1fr);gap:24px;padding-bottom:28px}
.sg3-product[data-design-family="workspace"] .project-hero .sg3-hero-copy{max-width:850px}
.sg3-product[data-design-family="workspace"] .r20-visual-stage{background:#e7eeed;padding:clamp(14px,2.2vw,26px)}
.sg3-product[data-design-family="workspace"] .r20-visual-stage.sg3-scene{background:#14252b;color:#e0e9e2;padding:0;max-width:860px;justify-self:center}
.sg3-product[data-design-family="workspace"] .r20-visual-stage.sg3-scene canvas{max-height:380px;object-fit:contain}
.sg3-product[data-design-family="workspace"] .r12-hero-proof>figure{width:min(100%,1000px)}
/* B: web products — browser-oriented display and compact introduction; no fake browser chrome. */
.sg3-product[data-design-family="web"]{--product-accent:#385c8a}
.sg3-product[data-design-family="web"] .project-hero{max-width:none;background:#edf2f7;display:grid;grid-template-columns:minmax(0,.78fr) minmax(0,1.22fr);padding-left:max(var(--pad),calc((100% - var(--max))/2 + var(--pad)));padding-right:max(var(--pad),calc((100% - var(--max))/2 + var(--pad)))}
.sg3-product[data-design-family="web"] .r20-visual-stage{background:#fff;padding:15px;border:1px solid #cad4df}
.sg3-product[data-design-family="web"] .r20-visual-stage.sg3-scene{background:#14252b;color:#dce7f1;padding:0;border:0}
.sg3-product[data-design-family="web"] .primary-download{background:#24496b;border-color:#24496b}
/* D: field analysis — dark forest with model and explanation; features use analysis/report structure */
.sg3-product[data-design-family="field"]{--product-accent:#376759}
.sg3-product[data-design-family="field"] .project-hero{max-width:none;display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);background:#12392f;color:#fff;padding-left:max(var(--pad),calc((100% - var(--max))/2 + var(--pad)));padding-right:max(var(--pad),calc((100% - var(--max))/2 + var(--pad)))}
.sg3-product[data-design-family="field"] .project-hero .sg3-hero-copy>p:not(.eyebrow),.sg3-product[data-design-family="field"] .project-hero .sg3-hero-copy>a{color:#dbe9df}
.sg3-product[data-design-family="field"] .r20-visual-stage{border-bottom:1px solid #6c9383}
/* D: terrain exhibition — full-width landscape composition, title above terrain. */
.sg3-product[data-design-family="relief"]{--product-accent:#376759}
.sg3-product[data-design-family="relief"] .project-hero{max-width:none;background:#112c25;color:white;display:grid;grid-template-columns:1fr;gap:24px;padding-left:max(var(--pad),calc((100% - var(--max))/2 + var(--pad)));padding-right:max(var(--pad),calc((100% - var(--max))/2 + var(--pad)))}
.sg3-product[data-design-family="relief"] .project-hero .sg3-hero-copy{display:grid;grid-template-columns:minmax(0,1.12fr) minmax(0,.88fr);gap:6px 40px;align-items:center}
.sg3-product[data-design-family="relief"] .sg3-hero-copy>a,.sg3-product[data-design-family="relief"] .sg3-hero-copy>.eyebrow,.sg3-product[data-design-family="relief"] .sg3-hero-copy>h1{grid-column:1}
.sg3-product[data-design-family="relief"] .sg3-hero-copy>p:not(.eyebrow){grid-column:2;grid-row:1/4;color:#dbe9df;margin-top:0}
.sg3-product[data-design-family="relief"] .project-actions{grid-column:2;grid-row:4;margin-top:0}
.sg3-product[data-design-family="relief"] .r20-visual-stage{background:#101f1a;max-width:1040px;justify-self:center}
.sg3-product[data-design-family="relief"] .r20-visual-stage canvas{max-height:500px;background:#101f1a;object-fit:contain}
/* D: map studio — light cartographic background, individual layer model, no dark title contrast issue */
.sg3-product[data-design-family="cartography"],.sg3-product[data-design-family="catalog"]{--product-accent:#466d58}
.sg3-product[data-design-family="cartography"] .project-hero,.sg3-product[data-design-family="catalog"] .project-hero{display:grid;grid-template-columns:minmax(0,.88fr) minmax(0,1.12fr);background:#e7ece3;max-width:none;padding-left:max(var(--pad),calc((100% - var(--max))/2 + var(--pad)));padding-right:max(var(--pad),calc((100% - var(--max))/2 + var(--pad)))}
.sg3-product[data-design-family="catalog"] .project-hero{background:#f0f3ee;grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
.sg3-product:is([data-design-family="cartography"],[data-design-family="catalog"]) .project-hero .sg3-hero-copy>p:not(.eyebrow),.sg3-product:is([data-design-family="cartography"],[data-design-family="catalog"]) .project-hero .sg3-hero-copy>a{color:#455e54}
.sg3-product:is([data-design-family="cartography"],[data-design-family="catalog"]) .eyebrow{color:#4f6755}
.sg3-product:is([data-design-family="cartography"],[data-design-family="catalog"]) .sg3-hero-copy .r08-state[data-status="complete"]{color:#216243!important}
.sg3-product:is([data-design-family="cartography"],[data-design-family="catalog"]) .sg3-hero-copy .r08-state[data-status="active"]{color:#8a4b23!important}
.sg3-product:is([data-design-family="cartography"],[data-design-family="catalog"]) .secondary-service{color:#25493e;border-color:#688877}
.sg3-product:is([data-design-family="cartography"],[data-design-family="catalog"]) .secondary-service:hover{background:#d4e2d6}
/* Shared accessibility and functional navigation. */
.sg3-product[data-design-family] .sg3-pause{min-height:44px;flex-shrink:0}
.sg3-product[data-design-family] .project-hero a:focus-visible,.r20-catalog .catalog-line:focus-visible{outline:3px solid #b67b48;outline-offset:3px}
.sg3-product[data-design-family] .r12-hero-proof figcaption{overflow-wrap:anywhere}
/* Catalogue: editorial grid desktop, compact rows on phones. */
.r20-catalog .r07-catalog-side{margin-bottom:22px}
.r20-catalog .catalog-group-heading h3{letter-spacing:-.035em}
.r20-catalog .catalog-line{min-width:0}
.r20-catalog .catalog-line[hidden],.r20-catalog .catalog-group[hidden]{display:none!important}
.r20-catalog .r19-gallery-group .catalog-lines{align-items:stretch}
.r20-catalog .r19-gallery-group .catalog-line{grid-template-rows:auto auto 1fr auto;min-height:0}
.r20-catalog .r19-gallery-group .r08-text-row{min-height:0;display:flex;flex-direction:column;justify-content:center}
.r20-catalog .r19-gallery-group .catalog-line-meta{margin-top:auto}
@media(max-width:760px){
.sg3-product[data-design-family] .project-hero,.sg3-product[data-design-family="relief"] .project-hero{grid-template-columns:minmax(0,1fr);display:grid;padding:20px var(--pad) 26px;gap:20px;max-width:none}
.sg3-product[data-design-family] .project-hero h1{font-size:clamp(30px,8vw,40px);line-height:1.12;letter-spacing:-.035em;max-width:none}
.sg3-product[data-design-family] .project-hero .sg3-hero-copy,.sg3-product[data-design-family="relief"] .project-hero .sg3-hero-copy{display:block;grid-row:1}
.sg3-product[data-design-family] .project-hero .sg3-hero-copy>p:not(.eyebrow){font-size:15px;line-height:1.7;margin-top:12px}
.sg3-product[data-design-family] .r20-visual-stage{padding:12px}
.sg3-product[data-design-family] .r20-visual-stage.sg3-scene{padding:0}
.sg3-product[data-design-family] .project-actions{margin-top:16px;gap:8px}
.sg3-product[data-design-family] .project-quick{grid-template-columns:1fr 1fr;gap:8px 16px;padding-top:16px;padding-bottom:16px}
.sg3-product[data-design-family] .project-quick>div,.sg3-product[data-design-family] .project-quick>div:first-child{padding:6px 0;border:0;border-bottom:1px solid var(--line)}
.sg3-product[data-design-family] .project-quick>div:nth-child(3){grid-column:1/-1}
.sg3-product[data-design-family] .project-quick strong{font-size:14px}
.sg3-product[data-design-family] .r07-product-sections{gap:6px 16px;padding:4px var(--pad)}
.sg3-product[data-design-family] .r07-product-sections a{font-size:12px}
.sg3-product[data-design-family] .r20-feature-layout{grid-template-columns:1fr;gap:20px;padding-top:26px;padding-bottom:28px}
.sg3-product[data-design-family] .r17-release{padding:18px}
.sg3-product[data-design-family] .r19-workflow{padding-top:25px;padding-bottom:25px;gap:16px}
.r20-catalog.r19-product-gallery .inner-hero{padding-top:26px;padding-bottom:24px;gap:20px}
.r20-catalog .r19-showcase-art img{max-height:200px}
.r20-catalog .r19-gallery-group{padding:23px 0 25px}
.r20-catalog .r19-gallery-group .catalog-lines{gap:0;border-top:1px solid var(--line)}
.r20-catalog .r19-gallery-group .catalog-line,.r20-catalog .r19-gallery-group .r08-text-row{display:grid;grid-template-columns:minmax(0,1fr) minmax(64px,26%);grid-template-rows:auto auto auto;gap:5px 10px;padding:15px 0 14px;min-height:0;border:0;border-bottom:1px solid var(--line);background:transparent;align-content:start}
.r20-catalog .r19-gallery-group .catalog-line-name{grid-column:1;grid-row:1}
.r20-catalog .r19-gallery-group .catalog-line>p{grid-column:1;grid-row:2;font-size:13px;line-height:1.55}
.r20-catalog .r19-gallery-group .catalog-line-meta{grid-column:1/-1;grid-row:3;font-size:11px;margin-top:6px;padding-right:20px}
.r20-catalog .r19-gallery-group .catalog-line-name h3{font-size:17px;margin:3px 0;line-height:1.32}
.r20-catalog .r19-gallery-group .catalog-line-name small{font-size:11px}
.r20-catalog .r19-gallery-group .sg3-product-object{grid-column:2;grid-row:1/3;align-self:center;padding:4px;order:0}
.r20-catalog .r19-gallery-group .r07-preview-label{font-size:9px;text-align:center;line-height:1.3}
.r20-catalog .r19-gallery-group .r08-text-row .catalog-line-name,.r20-catalog .r19-gallery-group .r08-text-row>p{grid-column:1/-1}
.r20-catalog .r19-gallery-group .catalog-arrow{right:0;bottom:16px;font-size:18px}
.r20-catalog .r19-atlas-group{gap:14px;padding:24px 0}
.r20-catalog .r19-atlas-group .catalog-group-heading{display:grid;grid-template-columns:minmax(0,1fr) 32%;gap:6px 12px;align-items:center}
.r20-catalog .r19-atlas-group .catalog-group-heading h3{grid-column:1;font-size:22px;line-height:1.3}
.r20-catalog .r19-atlas-group .catalog-group-heading p{grid-column:1;margin:0;font-size:12px}
.r20-catalog .r19-atlas-group .r19-group-art{grid-column:2;grid-row:1/3;margin:0}
.r20-catalog .r19-atlas-group .r19-group-art figcaption{font-size:9px;line-height:1.3}
.r20-catalog .r19-atlas-group .catalog-line-name h3{font-size:18px}
.r20-catalog .r19-atlas-group .catalog-line{padding-top:12px;padding-bottom:12px}
.r20-catalog .r19-atlas-group .catalog-line>p{font-size:13px}
}

/* R21: progressive, non-blocking cinematic motion */
.r21-enter{animation:r21-arrive 420ms cubic-bezier(.2,.7,.3,1) both}
@keyframes r21-arrive{from{opacity:.82;transform:translateY(7px)}to{opacity:1;transform:translateY(0)}}
.r21-reveal{animation:r21-rise 550ms cubic-bezier(.2,.7,.3,1) both}
@keyframes r21-rise{from{opacity:.78;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
.r19-cinema-title{transform:translateY(var(--r21-title-shift,0px));}
.r19-cinema-world canvas{transform:scale(var(--r21-space-scale,1));transform-origin:50% 50%;}
.r19-cinema-world figure{overflow:hidden}
.r21-chapter-nav{display:flex;flex-wrap:wrap;gap:8px 22px;align-items:center;margin-top:18px;font-size:12px;line-height:1.5}
.r21-chapter-nav a{color:inherit;text-decoration:none;border-bottom:1px solid transparent;padding:5px 0;min-height:32px;display:inline-flex;align-items:center}
.r21-chapter-nav a[aria-current="location"]{border-color:currentColor;font-weight:700}
@media(prefers-reduced-motion:reduce){.r21-enter,.r21-reveal{animation:none!important}.r19-cinema-title,.r19-cinema-world canvas{transform:none!important}}


/* R22 — scene-to-page integration. No renderer or product-data changes. */
.sg3-product[data-design-family] figure.sg3-scene{background:linear-gradient(180deg,var(--r22-top),var(--r22-bottom));color:#f4f7f4;border:0;padding:0;overflow:hidden;min-width:0}
.sg3-product[data-design-family] figure.sg3-scene canvas{display:block;background:transparent;width:100%;max-width:100%;height:auto;max-height:none;aspect-ratio:3/2;object-fit:contain;margin:0 auto;mask-image:linear-gradient(90deg,transparent,#000 5%,#000 95%,transparent);-webkit-mask-image:linear-gradient(90deg,transparent,#000 5%,#000 95%,transparent)}
.sg3-product[data-design-family] .r22-caption{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 18px;border-top:1px solid #ffffff24;background:#0d171bb3;color:#f3f6f4;min-height:76px;line-height:1.45}
.r22-caption-copy{display:grid;gap:4px;min-width:0}.r22-caption-copy strong{font-size:15px;font-weight:600;letter-spacing:-.025em;color:#fff;word-break:keep-all}.r22-caption-copy>span{font-size:11px;color:#d6dedb;word-break:keep-all}.r22-controls{display:flex;align-items:center;gap:12px;flex-shrink:0}.r22-render-mode{font-size:11px;color:#d7dfdc;white-space:nowrap}.r22-controls .sg3-pause{min-height:44px;min-width:92px;border-color:#c3d4cf;color:#fff}.r22-controls .sg3-pause:hover{background:#ffffff18}
/* Dark galleries: continuous environment instead of a nested rectangular frame. */
.sg3-product[data-design-family] .r19-workflow,.sg3-product:is([data-design-family="field"],[data-design-family="relief"]) .r19-model-hero{background:linear-gradient(160deg,var(--r22-top),var(--r22-bottom));color:#f6f7f3}
.sg3-product[data-design-family] .r19-workflow figure.sg3-scene,.sg3-product:is([data-design-family="field"],[data-design-family="relief"]) .r19-model-hero figure.sg3-scene{background:transparent}
.sg3-product[data-design-family] .r19-workflow figure.sg3-scene canvas,.sg3-product:is([data-design-family="field"],[data-design-family="relief"]) .r19-model-hero figure.sg3-scene canvas{mask-image:linear-gradient(90deg,transparent,#000 9%,#000 91%,transparent),linear-gradient(180deg,transparent,#000 8%,#000 92%,transparent);mask-composite:intersect;-webkit-mask-image:linear-gradient(90deg,transparent,#000 9%,#000 91%,transparent),linear-gradient(180deg,transparent,#000 8%,#000 92%,transparent);-webkit-mask-composite:source-in}
.sg3-product[data-design-family] .r19-workflow .r22-caption,.sg3-product:is([data-design-family="field"],[data-design-family="relief"]) .r19-model-hero .r22-caption{background:transparent;padding-left:0;padding-right:0;border-top-color:#ffffff40}
.sg3-product[data-design-family="relief"] .r20-visual-stage.sg3-scene{max-width:880px}.sg3-product[data-design-family="workspace"] .r20-visual-stage.sg3-scene{max-width:740px}.sg3-product[data-design-family="workspace"] .r20-visual-stage.sg3-scene canvas{max-height:none;height:auto}
.sg3-product[data-design-family] .r19-workflow h2{max-width:16ch;line-height:1.17}.sg3-product[data-design-family] .r19-workflow .section-kicker{color:#f0cc9d}
/* The solar-system exhibition rail occupies its own row, never the orbit area. */
.r19-cinema-world figure{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;column-gap:12px;overflow:visible}
.r19-cinema-world .sg3-scene canvas{grid-column:1/-1;grid-row:1;background:transparent;justify-self:center;margin:0 auto;mask-image:radial-gradient(ellipse 75% 74%,#000 51%,transparent 100%);-webkit-mask-image:radial-gradient(ellipse 75% 74%,#000 51%,transparent 100%)}
.r19-cinema-world figcaption{position:static;grid-column:2;grid-row:2;display:flex;flex-direction:row;gap:13px;align-items:center;justify-content:flex-end;padding:0;z-index:1;color:#d9e0df}.r19-cinema-world .r11-legend{position:static;grid-row:2;grid-column:1;align-self:center;margin:0;flex-wrap:wrap;gap:12px 18px}.r19-cinema-world .r11-art-label>span{display:none}.r19-cinema-world .r22-render-mode{color:#c9d2d0}.r19-cinema-world .sg3-pause{min-height:44px}.r19-cinema-world .r11-legend span{gap:7px}
@media(min-width:761px){.r19-cinema h1{font-size:clamp(68px,9vw,136px)}.r19-cinema-world .sg3-scene canvas{width:min(100%,max(390px,calc((100svh - 390px)*1.5)),960px);min-width:0;margin:-16px auto 0}.r19-cinema-world{max-width:1180px}.r19-cinema{padding-top:28px;padding-bottom:22px}.r19-cinema-bottom{padding-top:15px}}
@media(max-width:760px){.r19-cinema-world figure{grid-template-columns:1fr;row-gap:12px}.r19-cinema-world .sg3-scene canvas{width:100%;margin:0;grid-column:1}.r19-cinema-world .r11-legend{grid-column:1;grid-row:2;margin:0;justify-content:center;gap:10px 15px}.r19-cinema-world figcaption{grid-column:1;grid-row:3;justify-content:space-between;flex-wrap:wrap;gap:8px;margin:0}.r19-cinema-world .r11-art-label{display:none}.r19-cinema-world .sg3-pause{min-width:100px}.r19-cinema-bottom{margin-top:12px}.sg3-product[data-design-family] .r22-caption{padding:10px 12px;display:grid;grid-template-columns:1fr;min-height:0;gap:10px}.r22-controls{justify-content:space-between}.r22-caption-copy strong{font-size:14px}.sg3-product[data-design-family] .r19-workflow .r22-caption,.sg3-product:is([data-design-family="field"],[data-design-family="relief"]) .r19-model-hero .r22-caption{padding:10px 0}.sg3-product[data-design-family] .r19-workflow h2{max-width:none}}
@media(prefers-reduced-motion:reduce){.r19-cinema-world canvas{transform:none!important}}

/* R23 — interactive solar-system exhibition, independently scoped to the home scene. */
.r19-cinema-world .r23-solar{display:flex;flex-direction:column;align-items:stretch;gap:0;overflow:visible;width:100%}
.r23-solar .r23-stage{position:relative;isolation:isolate;aspect-ratio:2.34/1;max-height:590px;width:100%;overflow:hidden;touch-action:none;cursor:grab;outline:0;background:radial-gradient(circle at 50% 48%,#1a1110 0%,#0b111a 26%,#071019 68%,#050b12 100%);border:1px solid #d4a27266;border-radius:24px;box-shadow:inset 0 0 0 1px #ffffff08,0 32px 72px #02070d72;user-select:none}.r23-stage.r23-dragging{cursor:grabbing}.r23-stage:focus-visible{outline:2px solid #e5b17e;outline-offset:4px}.r19-cinema-world .r23-solar .r23-stage canvas{position:absolute;inset:0;display:block;width:100%!important;height:100%!important;min-width:0;max-width:none;max-height:none;aspect-ratio:auto;margin:0!important;transform:none!important;mask-image:none!important;-webkit-mask-image:none!important;object-fit:fill}.r23-labels{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:2}.r23-label{position:absolute;transform:translate(-50%,-50%);display:inline-flex;align-items:center;gap:8px;padding:8px 12px;border:1px solid #ffffff16;border-radius:999px;background:color-mix(in srgb,#0b111a 80%, transparent);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);font-size:12px;color:#f4f4ef;white-space:nowrap;line-height:1;font-weight:560;letter-spacing:-.01em;text-shadow:0 1px 3px #000;box-shadow:0 12px 28px #02070d46}.r23-label[hidden]{display:none!important}.r23-label::before{content:'';width:7px;height:7px;border-radius:50%;background:var(--planet-color);box-shadow:0 0 0 3px color-mix(in srgb,var(--planet-color) 22%, transparent)}.r23-label b{font-size:12px;font-weight:700;color:#fff3e2}.r23-label span{font-size:11px;color:#c9d5d8;letter-spacing:.01em}.r19-cinema-world .r23-solar figcaption,.r23-leaders,.r23-toolbar,.r23-instructions,.r23-planet-index,.r23-scale-note{display:none!important}
.r19-cinema:has(.r23-solar){min-height:0;grid-template-rows:auto auto auto;gap:10px}.r19-cinema:has(.r23-solar) h1{font-size:clamp(62px,8.5vw,118px);line-height:.98}.r19-cinema:has(.r23-solar) .r19-cinema-bottom{padding-top:8px}
@media(max-width:1000px){.r23-solar .r23-stage{aspect-ratio:2.02/1}}
@media(max-width:760px){.r19-cinema:has(.r23-solar){padding-top:28px;gap:7px}.r19-cinema:has(.r23-solar) h1{font-size:clamp(43px,11.4vw,82px)}.r23-solar .r23-stage{aspect-ratio:1.18/1;max-height:none}.r23-label{padding:5px 8px;gap:5px;font-size:10px;max-width:min(42vw,158px)}.r23-label::before{width:6px;height:6px}.r23-label b{font-size:10px}.r23-label span{font-size:10px;overflow:hidden;text-overflow:ellipsis}}

</style></head><body><a class="skip-link" href="#main">본문으로 바로가기</a><header class="site-header corporate-header r19-header"><a aria-label="Sunrise Group 홈" class="brand" href="#/"><span aria-hidden="true" class="brand-mark sg-brand-emblem"><svg aria-hidden="true" focusable="false" viewbox="0 0 40 40"><path d="M7 22a13 13 0 0 1 26 0Z" fill="#ce622f"></path><path d="M4 26h32M9 31h22M15 36h10" fill="none" stroke="currentColor" stroke-width="2.4"></path></svg></span><span><strong>Sunrise Group</strong></span></a><nav aria-label="주요 메뉴" class="desktop-nav"><div class="r07-nav-program r11-group-nav"><a class="nav-card" href="#/about"><span class="nav-copy"><strong>그룹 소개</strong></span></a><button aria-controls="group-submenu" aria-expanded="false" aria-label="그룹 소개 하위 메뉴" class="r07-nav-toggle" type="button"><svg aria-hidden="true" viewbox="0 0 16 16"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6"></path></svg></button><div class="r07-submenu" hidden="" id="group-submenu"><a href="#/about"><strong>그룹 소개</strong><small>그룹의 목표와 개발 목적</small></a><a href="#/philosophy"><strong>이념과 원칙</strong><small>개발에서 지키는 기준</small></a><a href="#/future"><strong>미래 방향</strong><small>앞으로의 개발 방향</small></a></div></div><div class="r07-nav-program"><a class="nav-card" href="#/programs"><span class="nav-copy"><strong>프로그램</strong></span></a><button aria-controls="program-submenu" aria-expanded="false" aria-label="프로그램 하위 메뉴" class="r07-nav-toggle" type="button"><svg aria-hidden="true" viewbox="0 0 16 16"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6"></path></svg></button><div class="r07-submenu" hidden="" id="program-submenu"><a href="#/programs/pc"><strong>PC 프로그램</strong><small>문서 작업 · 환경영향평가 · 웹 서비스</small></a><a href="#/programs/qgis"><strong>QGIS 플러그인</strong><small>공간 분석 · 지도 제작 · 현장자료</small></a></div></div><div class="r07-nav-program"><a class="nav-card" href="#/development"><span class="nav-copy"><strong>개발 현황</strong></span></a><button aria-controls="development-submenu" aria-expanded="false" aria-label="개발 현황 하위 메뉴" class="r07-nav-toggle" type="button"><svg aria-hidden="true" viewbox="0 0 16 16"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6"></path></svg></button><div class="r07-submenu" hidden="" id="development-submenu"><a href="#/development#pc-status"><strong>PC 프로그램</strong><small>개발 중 2개 · 개발 중지 2개</small></a><a href="#/development#qgis-status"><strong>QGIS 플러그인</strong><small>개발 중 3개 · 개발 중지 0개</small></a></div></div><a class="nav-card" href="#/help"><span class="nav-copy"><strong>이용 안내</strong></span></a></nav><details class="mobile-menu"><summary>메뉴</summary><nav aria-label="모바일 메뉴"><p class="r11-mobile-group">그룹</p><a href="#/about">그룹 소개</a><a class="r05-mobile-child" href="#/philosophy">이념과 원칙</a><a class="r05-mobile-child" href="#/future">미래 방향</a><p class="r11-mobile-group">프로그램</p><a href="#/programs">전체 프로그램</a><a class="r05-mobile-child" href="#/programs/pc">PC 프로그램</a><a class="r05-mobile-child" href="#/programs/qgis">QGIS 플러그인</a><p class="r11-mobile-group">개발 현황</p><a href="#/development">전체 개발 현황</a><a class="r05-mobile-child" href="#/development#pc-status">PC 개발 현황</a><a class="r05-mobile-child" href="#/development#qgis-status">QGIS 개발 현황</a><p class="r11-mobile-group">지원</p><a href="#/help">이용 안내</a></nav></details></header><div class="sg-wayfinding"><div><a href="#/">홈</a><span aria-hidden="true">/</span><span aria-live="polite" class="sg-location">홈</span></div></div><div id="page-outlet"></div><footer class="r19-footer"><div class="footer-top"><a class="brand" href="#/"><span aria-hidden="true" class="brand-mark sg-brand-emblem"><svg aria-hidden="true" focusable="false" viewbox="0 0 40 40"><path d="M7 22a13 13 0 0 1 26 0Z" fill="#ce622f"></path><path d="M4 26h32M9 31h22M15 36h10" fill="none" stroke="currentColor" stroke-width="2.4"></path></svg></span><span><strong>Sunrise Group</strong></span></a><nav aria-label="하단 메뉴"><a href="#/about">그룹 소개</a><a href="#/programs">프로그램</a><a href="#/development">개발 현황</a><a href="#/help">이용 안내</a><a href="#/programs/pc">PC 프로그램</a><a href="#/programs/qgis">QGIS 플러그인</a></nav></div><div class="footer-bottom"><p>실무에 필요한 도구를 만듭니다.</p><span>© 2026 Sunrise Group</span></div></footer><template data-route="/"><main class="home-v2 home-3d-page" id="main"><section class="r19-cinema home-stage"><div class="r19-cinema-title"><h1 aria-label="Sunrise Group"><span>Sunrise</span> <span>Group</span></h1></div><div class="r19-cinema-world"><figure class="sg3-scene r04-scene r23-solar" data-scene="/"><div class="r23-stage" tabindex="0" role="img" aria-label="Sunrise Group의 실제 태양계 구성 메인 비주얼. 태양과 8개 행성에 그룹의 가치와 분야가 이름으로 표시됩니다."><canvas aria-hidden="true" width="1100" height="500"></canvas><div class="r23-labels" aria-hidden="true"><div class="r23-label" data-body="sun" style="--planet-color:#ffad52"><b>태양</b><span>Sunrise Group</span></div><div class="r23-label" data-body="rock" style="--planet-color:#aaa095"><b>수성</b><span>실무 기반</span></div><div class="r23-label" data-body="venus" style="--planet-color:#e2c49a"><b>금성</b><span>사용 경험</span></div><div class="r23-label" data-body="earth" style="--planet-color:#80bcd6"><b>지구</b><span>환경 평가</span></div><div class="r23-label" data-body="mars" style="--planet-color:#c77b53"><b>화성</b><span>개선 역량</span></div><div class="r23-label" data-body="jupiter" style="--planet-color:#d3b38d"><b>목성</b><span>PC 솔루션</span></div><div class="r23-label" data-body="saturn" style="--planet-color:#e2d1a2"><b>토성</b><span>보안 신뢰</span></div><div class="r23-label" data-body="uranus" style="--planet-color:#91cbd2"><b>천왕성</b><span>공간 정보</span></div><div class="r23-label" data-body="neptune" style="--planet-color:#719be9"><b>해왕성</b><span>확장 비전</span></div></div></div></figure></div><div class="r19-cinema-bottom"><div class="r19-cinema-narrative"><div class="r10-home-copy"><p class="r07-home-lead">실무의 문제를 기술로 풀어갑니다.</p><p class="vision-lead">문서와 공간정보를 다루는 현장에서 출발해, 더 편리하고 안전한 업무 환경을 만드는 소프트웨어를 개발합니다.</p><div class="home-actions"><a class="primary-action" href="#/about">그룹 소개 <span aria-hidden="true">→</span></a></div></div></div><div class="r19-cinema-links"><a class="r07-scroll" href="#/#purpose">그룹의 목표와 이념 <span aria-hidden="true">↓</span></a></div></div></section>
<section class="r07-purpose r19-story" id="purpose"><div class="r07-section-label">그룹의 목표</div><div><h2>업무를 이해하는 것에서 개발을 시작합니다.</h2><p>반복되는 문서 작업과 환경영향평가, 공간정보 분석에는 많은 시간이 필요합니다. Sunrise Group은 업무 현장에서 필요한 기능을 중심으로 소프트웨어를 설계하고, 실제 사용 과정에서 발견되는 문제를 개선합니다.</p><a class="inline-next" href="#/about">그룹 소개 자세히 보기 <span aria-hidden="true">→</span></a></div></section>
<section class="r07-principle-band r19-values-section"><div><h2>개발 이념</h2><p>기능보다 쓰임을 먼저 생각합니다.</p></div><div class="r07-values"><article><h3>사용 편의성</h3><p>필요한 기능을 쉽게 찾고 작업을 간단하게 이어갈 수 있도록 설계합니다.</p></article><article><h3>자료 보호</h3><p>원본과 기존 작업 환경을 보호하는 것을 기본으로 삼습니다.</p></article><article><h3>지속적인 검증</h3><p>실제 사용 환경을 기준으로 안정성과 품질을 개선합니다.</p></article><a class="inline-next" href="#/philosophy">이념과 원칙 <span aria-hidden="true">→</span></a></div></section>
<section class="r07-home-end r19-end"><h2>앞으로의 방향</h2><p>개별 업무 도구를 넘어, 문서와 공간정보가 자연스럽게 연결되는 업무 환경을 만들어갑니다.</p><a class="inline-next" href="#/future">미래 방향 <span aria-hidden="true">→</span></a></section></main></template><template data-route="/about"><main class="sg3-page sg3-identity r07-corporate r19-editorial-about" id="main"><section class="inner-hero r07-corporate-title"><div class="sg3-hero-copy"><p class="eyebrow"><span></span>그룹 소개</p><h1>실무에서 시작하는 변화</h1><p>일의 흐름을 이해하고, 누구나 쉽게 사용할 수 있는 도구를 만듭니다.</p></div></section><div class="r19-editorial-index"><a aria-current="page" href="#/about">그룹 소개</a><a href="#/philosophy">이념과 원칙</a><a href="#/future">미래 방향</a></div><section class="about-section r07-about-feature"><div class="about-title"><p class="section-kicker">우리의 정체성</p><h2>사람의 일을<br/>더 단순하고 안전하게.</h2></div><div class="about-copy"><p class="lead">Sunrise Group은 반복되는 작업을 줄이고 필요한 정보를 더 쉽게 활용할 수 있도록 소프트웨어를 개발하는 프로젝트입니다.</p><p>화면 캡처와 PDF 문서 작업부터 환경영향평가, 파일 관리까지 실제 업무에서 마주하는 불편을 살펴봅니다. 사용하는 사람의 작업 순서를 이해하고 필요한 기능을 명확하게 전달하는 데 집중합니다.</p><p>작업을 시작하는 순간부터 결과를 확인할 때까지 흐름을 연결해, 사용자가 본래의 업무와 판단에 집중할 수 있도록 돕고자 합니다.</p><a class="inline-next" href="#/philosophy">우리가 지키는 원칙 보기 <span>→</span></a></div></section><section class="about-bridge r04-about-domains"><div><span>독립 실행 및 웹</span><h3><a href="#/programs/pc">PC 프로그램 →</a></h3><p>문서 작업·편집, 환경영향평가 업무와 웹 서비스</p></div><div><span>공간정보 확장 도구</span><h3><a href="#/programs/qgis">QGIS 플러그인 →</a></h3><p>지형, 보호·보전지구, 조사지점, 지도 제작 및 시각화</p></div></section><section class="about-next"><p>필요한 도구를 찾아보세요.</p><a href="#/programs">프로그램 보기 →</a></section></main></template><template data-route="/philosophy"><main class="sg3-page sg3-principles r07-corporate r19-editorial-principles" id="main"><section class="inner-hero r07-corporate-title"><div class="sg3-hero-copy"><p class="eyebrow"><span></span>이념과 원칙</p><h1>기술보다 먼저, 사용자의 일</h1><p>실용성, 사용 편의, 데이터 보호와 검증을 공통 기준으로 삼습니다.</p></div></section><div class="r19-editorial-index"><a href="#/about">그룹 소개</a><a aria-current="page" href="#/philosophy">이념과 원칙</a><a href="#/future">미래 방향</a></div><section class="section principle-section"><div class="editorial-intro r07-editorial-feature"><p class="section-kicker">개발 원칙</p><p>좋은 도구는 해야 할 일을 분명하게 보여주고, 사용자가 안심하고 다음 단계로 나아가도록 돕습니다.</p></div><div class="principle-grid"><article><span>01</span><h3>실무에서 출발</h3><p>반복되는 업무와 사용자의 실제 불편을 먼저 살펴봅니다. 기능의 수보다 실제 작업에 도움이 되는지를 생각합니다.</p></article><article><span>02</span><h3>쉽고 명확하게</h3><p>필요한 정보와 작업을 찾기 쉬운 화면으로 구성합니다. 버튼과 안내는 사용자가 다음 행동을 이해할 수 있도록 씁니다.</p></article><article><span>03</span><h3>자료를 안전하게</h3><p>사용자의 원본과 자료를 소중히 다룹니다. 중요한 작업은 대상과 결과를 확인할 수 있도록 설계합니다.</p></article><article><span>04</span><h3>검증하고 개선</h3><p>실제 사용 환경을 확인하고 발견한 문제를 보완합니다. 확인된 사실과 아직 검토가 필요한 사항을 구분합니다.</p></article></div><div class="editorial-next"><p>원칙은 제품을 만드는 과정에서 실천합니다.</p><a href="#/future">앞으로의 방향 보기 →</a></div></section></main></template><template data-route="/programs"><main class="sg3-page sg3-ecosystem r05-overview r19-portal-page" id="main"><section class="inner-hero"><div class="sg3-hero-copy"><p class="eyebrow"><span></span>개발 제품</p><h1>프로그램과 QGIS 플러그인</h1><p>업무 환경에 맞는 도구를 선택하세요. 독립 실행 프로그램과 웹 서비스, QGIS 공간분석 플러그인을 제공합니다.</p></div></section><section class="section program-catalog"><div class="section-heading"><div><p class="section-kicker">두 가지 개발 분야</p><h2>개발 분야</h2></div><p>이용 환경에 따라 프로그램을 찾아보세요.</p></div><div class="r05-portal-grid"><a class="r05-portal" href="#/programs/pc"><div class="r19-portal-visual"><img alt="" src="data:image/png;base64,"/><span>PDF PRO 실제 실행 화면</span></div><div><small>독립 실행 및 웹</small><h3>PC 프로그램</h3><p>문서 작업·편집, 환경영향평가, 웹 서비스</p><b>프로그램 13개 · 확인 중 3개 →</b></div></a><a class="r05-portal" href="#/programs/qgis"><div class="r19-portal-visual"><img alt="" src="data:image/webp;base64,"/><span>입체 지형 · 기능 설명용 모델</span></div><div><small>공간정보 확장 도구</small><h3>QGIS 플러그인</h3><p>현장자료 관리, 환경영향평가, 지형 분석, 지도 제작</p><b>10개 플러그인 · 개발 완료 7개 · 개발 중 3개 →</b></div></a></div></section></main></template><template data-route="/development"><main class="sg3-page sg3-build r07-corporate r09-development r19-development" id="main"><section class="inner-hero r07-corporate-title"><div class="sg3-hero-copy"><p class="eyebrow"><span></span>개발 현황</p><h1>개발 현황</h1><p>현재 개발 중이거나 개발이 중지된 프로젝트를 안내합니다.</p></div></section><section class="section"><nav aria-label="개발 분야 바로가기" class="status-nav r09-development-nav"><a href="#/development#pc-status">PC 프로그램</a><a href="#/development#qgis-status">QGIS 플러그인</a></nav><section aria-labelledby="pc-status-title" class="r09-development-category" id="pc-status"><div class="r09-category-heading"><h2 id="pc-status-title">PC 프로그램</h2><p>개발 중 2개 · 개발 중지 2개</p></div><section class="r09-status-section" id="active"><h3>개발 중<span>2개</span></h3><div class="status-list"><a class="status-row" href="#/projects/eia-hub"><div><span>환경 데이터 · 웹</span><h3>Sunrise EIA Data Hub</h3><p>환경영향평가 실무에 필요한 기관과 지자체 자료를 찾는 웹 프로젝트입니다.</p></div><div><b class="r08-state" data-status="active">개발 중</b><small>상세 보기 →</small></div></a><a class="status-row" href="#/projects/eia-manager"><div><span>사업관리</span><h3>EIA Manager</h3><p>환경영향평가 사업의 진행 단계와 계약·수금·업무 일정을 관리하기 위한 프로그램입니다.</p></div><div><b class="r08-state" data-status="active">개발 중</b><small>상세 보기 →</small></div></a></div></section><section class="r09-status-section" id="ended"><h3>개발 중지<span>2개</span></h3><div class="status-list"><a class="status-row" href="#/projects/finder"><div><span>공간정보</span><h3>Sunrise Finder</h3><p>주소·좌표·지도·공공데이터·현장사진·공간분석을 프로젝트로 연결합니다.</p></div><div><b class="r08-state" data-status="stopped">개발 중지</b><small>상세 보기 →</small></div></a><a class="status-row" href="#/projects/aermod"><div><span>대기환경</span><h3>Sunrise Aermod</h3><p>AERMOD 입력과 실행·결과 검토 절차를 지원하는 프로젝트입니다.</p></div><div><b class="r08-state" data-status="stopped">개발 중지</b><small>상세 보기 →</small></div></a></div></section></section><section aria-labelledby="qgis-status-title" class="r09-development-category" id="qgis-status"><div class="r09-category-heading"><h2 id="qgis-status-title">QGIS 플러그인</h2><p>개발 중 3개 · 개발 중지 0개</p></div><section class="r09-status-section" id="qgis-active"><h3>개발 중<span>3개</span></h3><div class="status-list"><a class="status-row" href="#/projects/3d-map"><div><span>QGIS 플러그인 · 0.24.0 R23</span><h3>Sunrise 3D Map</h3><p>다중 DEM과 수치지도 자료를 다루고 표고 기반의 입체 지형을 구성하는 QGIS 플러그인입니다.</p></div><div><b class="r08-state" data-status="active">개발 중</b><small>상세 보기 →</small></div></a><a class="status-row" href="#/projects/color-distributor"><div><span>QGIS 플러그인 · 0.1.5 P5.1</span><h3>QGIS 컬러 분배기</h3><p>벡터 레이어의 색상·선·면 패턴·점 마커를 미리보기한 뒤 선택 심볼에 적용합니다.</p></div><div><b class="r08-state" data-status="active">개발 중</b><small>상세 보기 →</small></div></a><a class="status-row" href="#/projects/survey-locator"><div><span>QGIS 플러그인 · 1.0.0</span><h3>조사지점 찾기</h3><p>지명·주소, 위경도, TM 좌표를 복수 건 입력해 QGIS 지도에 조사지점 레이어를 생성합니다.</p></div><div><b class="r08-state" data-status="active">개발 중</b><small>상세 보기 →</small></div></a></div></section><section class="r09-status-section" id="qgis-ended"><h3>개발 중지<span>0개</span></h3><p class="r09-empty">해당 프로젝트가 없습니다.</p></section></section></section></main></template><template data-route="/future"><main class="sg3-page sg3-future r07-corporate r19-editorial-future" id="main"><section class="inner-hero r07-corporate-title"><div class="sg3-hero-copy"><p class="eyebrow"><span></span>미래 방향</p><h1>더 나은 업무 환경을 향해</h1><p>제품의 쓰임을 넓히고 실제 업무에서 오래 사용할 수 있는 품질을 쌓아갑니다.</p></div></section><div class="r19-editorial-index"><a href="#/about">그룹 소개</a><a href="#/philosophy">이념과 원칙</a><a aria-current="page" href="#/future">미래 방향</a></div><section class="section"><div class="editorial-intro r07-editorial-feature"><p class="section-kicker">우리의 방향</p><p>사용자의 작업을 더 자연스럽게 이어주기 위해 세 가지 방향을 살펴보고 있습니다.</p></div><div class="future-grid"><article><span>01 · 연결</span><h3>흩어진 업무를 연결</h3><p>문서, 환경 데이터와 파일 작업이 자연스럽게 이어지도록 제품 간 흐름을 고민합니다.</p></article><article><span>02 · 단순화</span><h3>반복을 줄이는 방법</h3><p>자료를 찾고 정리하는 데 드는 시간을 줄일 수 있도록 일상적인 업무 과정을 살펴봅니다.</p></article><article><span>03 · 개선</span><h3>검증을 통한 개선</h3><p>실제 사용 환경에서 발견된 문제를 보완하고 안정성과 사용성을 높여갑니다.</p></article></div><div class="editorial-next"><p>현재 개발 중인 프로젝트의 상태를 확인할 수 있습니다.</p><a href="#/development">개발 현황 보기 →</a></div></section></main></template><template data-route="/help"><main class="sg3-page sg3-support r07-corporate r19-service-guide" id="main"><section class="inner-hero r07-corporate-title"><div class="sg3-hero-copy"><p class="eyebrow"><span></span>이용 안내</p><h1>프로그램 이용 안내</h1><p>자주 확인하는 이용 방법과 제품별 안내를 모았습니다.</p></div></section><section class="section help-page"><p class="section-kicker">이용 방법</p><h2>자주 묻는 질문</h2><div class="help-list"><details><summary>Windows 프로그램은 어떻게 시작하나요?</summary><p>제품 상세 페이지에서 지원 환경과 배포 형태를 확인한 뒤 다운로드 버튼을 선택하세요. 설치 파일은 안내에 따라 설치하고, 단일 실행 파일은 실행해 사용할 수 있습니다. ZIP 파일은 압축을 해제한 뒤 포함된 안내를 확인하세요.</p></details><details><summary>Drawing Editor는 어디에서 설치하나요?</summary><p>현재 제공되는 배포 자료에는 Windows 실행 파일이 포함되어 있지 않습니다. 실행 파일을 제공할 수 있게 되면 제품 상세 페이지에서 안내하겠습니다.</p></details><details><summary>웹 서비스와 Windows 프로그램은 같은가요?</summary><p>웹 서비스는 브라우저에서 사용하며, Windows 프로그램은 컴퓨터에서 실행합니다. 제품과 버전에 따라 기능이나 지원 문서가 다를 수 있으므로 각 제품의 상세 안내를 확인해 주세요.</p></details><details><summary>화면에 나온 버전과 현재 버전이 다릅니다.</summary><p>일부 실행 화면은 이전 버전에서 촬영되었습니다. 화면 아래의 설명과 제품 페이지에 표시된 배포 버전을 확인해 주세요.</p></details><details><summary>EIASS 자료 조회에 인터넷이 필요한가요?</summary><p>사업 검색, 원문 조회와 지도 기능에는 인터넷 연결이 필요합니다. Sunrise EIASS는 공개자료를 활용하는 별도 프로그램이며 EIASS 운영기관의 공식 소프트웨어는 아닙니다.</p></details><details><summary>PDF PRO에서 한글 문서 변환이 되지 않습니다.</summary><p>일부 변환은 한컴 등 문서를 처리할 수 있는 프로그램과 PDF 출력 환경이 필요할 수 있습니다. 지원 환경과 설치 상태를 확인해 주세요.</p></details><details id="qgis-guide"><summary>QGIS 플러그인은 어떻게 이용하나요?</summary><p>각 플러그인의 지원 QGIS 버전과 검증 상태를 먼저 확인하세요. 공개된 설치 ZIP이 있는 경우 QGIS의 플러그인 관리 및 설치 메뉴에서 ZIP 설치를 사용합니다. 현재 확인되지 않은 공개 배포 링크는 표시하지 않습니다.</p></details></div><div class="callout"><div><h3>프로그램별 상세 정보</h3><p>지원 환경과 실행 화면을 각 제품 페이지에서 확인할 수 있습니다.</p></div><a href="#/programs">프로그램 보기 →</a></div></section></main></template><template data-route="/projects/capture"><main style="--r22-top:#16202a;--r22-bottom:#25303c" class="sg3-page sg3-product r19-pc-proof" data-design-family="utility" id="main"><section aria-label="업무 도구 제품 소개" class="inner-hero project-hero r19-proof-hero r20-product-stage"><div class="sg3-hero-copy"><a href="#/programs/pc#work">← PC 프로그램 목록</a><p class="eyebrow"><span></span>화면 기록<!-- --> · <!-- -->정식 배포</p><h1>Sunrise Capture</h1><p>업무 화면을 캡처하고, 편집·저장·영역 녹화까지 한 흐름으로 처리합니다.</p><div class="project-actions"><a class="button primary-download" href="https://github.com/Peter-msk/Sunrise_capture/releases/download/v4.2.2/SunriseCapture_Setup.exe">프로그램 다운로드 ↓</a></div></div><section class="r12-hero-proof r20-visual-stage" id="screens"><h2>실제 실행 화면</h2><figure><a aria-label="Sunrise Capture 실행 화면 크게 보기 (새 창)" class="screen-full-link" data-image="true" href="data:image/png;base64," rel="noopener noreferrer" target="_blank"><img alt="Sunrise Capture 실제 실행 화면" src="data:image/png;base64,"/><span>화면 크게 보기 ↗</span></a><figcaption>사용자가 제공한 Sunrise Capture v4.0.0의 실제 캡처 기능 화면입니다. 현재 버전과 일부 다를 수 있습니다.</figcaption></figure></section></section><nav aria-label="제품 안내 바로가기" class="r07-product-sections r19-product-jump"><a href="#/projects/capture#screens">실제 실행 화면</a><a href="#/projects/capture#specifications">제품 정보</a><a href="#/projects/capture#features">주요 기능과 배포</a><a href="#/projects/capture#function-motion">기능 모션</a></nav><section class="section project-quick r19-specs" id="specifications"><div><span>이용 형태</span><strong>Windows 설치 파일</strong></div><div><span>지원 환경</span><strong>Windows 10 / 11 · 64비트</strong></div><div><span>배포 버전</span><strong>v4.2.2</strong></div></section><p class="distribution-note">배포 정보 확인: <!-- -->2026.11.17</p><section class="section project-detail-grid r19-feature-spread r20-feature-layout" id="features"><div><p class="section-kicker">버전과 개발 상태</p><h2>배포와 개발 현황</h2><div class="status-box"><small>배포 정보</small><strong>v4.2.2</strong></div><a class="detail-help" href="#/help">이용 안내 보기 →</a></div><div><p class="section-kicker">주요 기능</p><h2>주요 업무와 기능</h2><p class="detail-text">영역·전체 화면·활성 창 중 필요한 대상을 지정합니다. 반복·다중·스크롤 캡처로 여러 장의 기록이나 긴 화면도 정리할 수 있습니다.</p><p class="detail-text">영역 녹화로 화면의 변화와 작업 과정을 남깁니다. 자주 사용하는 크기와 품질 설정을 다시 활용해 반복 준비를 줄입니다.</p><p class="detail-text">캡처한 결과를 편집하고 파일로 저장하거나 클립보드로 전달합니다. 최근 항목을 활용해 후속 작업을 이어갑니다.</p><p class="detail-text"><strong>활용 예시: </strong>업무 매뉴얼 제작: 화면을 순서대로 캡처하고 편집한 뒤 문서에 삽입합니다.</p><ul class="feature-list"><li><span>0<!-- -->1</span>영역·반복·다중·스크롤 캡처</li><li><span>0<!-- -->2</span>영역 녹화와 품질 기억</li><li><span>0<!-- -->3</span>편집·클립보드·최근 항목 연동</li></ul></div></section><section aria-label="기능 설명 모션" class="r12-function-block r19-workflow" id="function-motion"><div><p class="section-kicker">작업 과정</p><h2>화면을 기록하고 저장하는 과정</h2><p>화면 영역을 선택하고 편집한 뒤 결과를 저장하는 기능을 입체 모형으로 표현했습니다.</p></div><figure class="sg3-scene r04-scene" data-scene="/projects/capture"><canvas aria-hidden="true" height="600" width="900"></canvas><figcaption class="r22-caption"><div class="r22-caption-copy"><strong>영역 지정과 화면 기록</strong><span>기능 설명용 모션 · 실제 실행 화면 아님</span></div><div class="r22-controls"><span class="r22-render-mode" aria-live="polite"></span><button aria-pressed="false" class="sg3-pause" type="button">모션 정지</button></div></figcaption></figure></section></main></template><template data-route="/projects/pdf-editor"><main style="--r22-top:#16202a;--r22-bottom:#25303c" class="sg3-page sg3-product r19-pc-proof" data-design-family="document" id="main"><section aria-label="문서 편집·변환 제품 소개" class="inner-hero project-hero r19-proof-hero r20-product-stage"><div class="sg3-hero-copy"><a href="#/programs/pc#editing">← PC 프로그램 목록</a><p class="eyebrow"><span></span>PDF 편집<!-- --> · <!-- -->정식 배포</p><h1>Sunrise PDF Editor</h1><p>페이지 구성, 주석·편집, 검색과 비교를 한곳에 모은 PDF 작업공간입니다.</p><div class="project-actions"><a class="button primary-download" href="https://github.com/Peter-msk/Sunrise-PDF-Editor/releases/download/v4.6.3/Sunrise_PDF_Editor_Setup_v4_6_3.exe">프로그램 다운로드 ↓</a><a class="button secondary-service" href="https://sunrise-pdf-editor.ko-pg.workers.dev/" rel="noopener noreferrer" target="_blank">웹 버전 바로가기 ↗</a></div></div><section class="r12-hero-proof r20-visual-stage" id="screens"><h2>실제 실행 화면</h2><figure><a aria-label="Sunrise PDF Editor 실행 화면 크게 보기 (새 창)" class="screen-full-link" data-image="true" href="data:image/png;base64," rel="noopener noreferrer" target="_blank"><img alt="Sunrise PDF Editor 실제 실행 화면" src="data:image/png;base64,"/><span>화면 크게 보기 ↗</span></a><figcaption>사용자가 제공한 PDF Editor v4.6.0 실제 실행 화면입니다. 현재 버전과 다를 수 있습니다.</figcaption></figure></section></section><nav aria-label="제품 안내 바로가기" class="r07-product-sections r19-product-jump"><a href="#/projects/pdf-editor#screens">실제 실행 화면</a><a href="#/projects/pdf-editor#specifications">제품 정보</a><a href="#/projects/pdf-editor#features">주요 기능과 배포</a><a href="#/projects/pdf-editor#function-motion">기능 모션</a></nav><section class="section project-quick r19-specs" id="specifications"><div><span>이용 형태</span><strong>Windows 설치 파일</strong></div><div><span>지원 환경</span><strong>Windows 10 / 11 · 64비트</strong></div><div><span>배포 버전</span><strong>v4.6.3</strong></div></section><p class="distribution-note">배포 정보 확인: <!-- -->2026.11.17</p><section class="section project-detail-grid r19-feature-spread r20-feature-layout" id="features"><div><p class="section-kicker">버전과 개발 상태</p><h2>배포와 개발 현황</h2><div class="status-box"><small>배포 정보</small><strong>v4.6.3</strong></div><a class="detail-help" href="#/help">이용 안내 보기 →</a></div><div><p class="section-kicker">주요 기능</p><h2>주요 업무와 기능</h2><p class="detail-text">여러 PDF를 병합하거나 문서를 분할하고 필요한 페이지를 삽입·추출합니다. 페이지 목록과 본문을 함께 보며 문서 구성을 확인합니다.</p><p class="detail-text">주석·도형·표·워터마크를 활용해 검토 의견과 문서 표시를 정리합니다. 중앙 캔버스에서 편집 결과를 확인합니다.</p><p class="detail-text">검색과 비교로 확인할 내용을 찾습니다. 리본 메뉴와 빠른 작업 패널을 이용해 대형 문서의 반복 작업을 이어갑니다.</p><p class="detail-text"><strong>활용 예시: </strong>제출 문서 정리: 필요한 페이지를 모으고 검토 주석과 워터마크를 반영한 뒤 저장합니다.</p><ul class="feature-list"><li><span>0<!-- -->1</span>페이지 병합·분할·삽입·추출</li><li><span>0<!-- -->2</span>주석·도형·표·워터마크 편집</li><li><span>0<!-- -->3</span>검색·비교·대형 PDF 안정 처리</li></ul></div></section><section aria-label="기능 설명 모션" class="r12-function-block r19-workflow" id="function-motion"><div><p class="section-kicker">작업 과정</p><h2>PDF 편집의 작업 흐름</h2><p>문서를 불러오고 페이지와 주석을 편집한 뒤 결과를 확인하는 과정을 표현합니다.</p></div><figure class="sg3-scene r04-scene" data-scene="/projects/pdf-editor"><canvas aria-hidden="true" height="600" width="900"></canvas><figcaption class="r22-caption"><div class="r22-caption-copy"><strong>페이지 구성과 주석 편집</strong><span>기능 설명용 모션 · 실제 실행 화면 아님</span></div><div class="r22-controls"><span class="r22-render-mode" aria-live="polite"></span><button aria-pressed="false" class="sg3-pause" type="button">모션 정지</button></div></figcaption></figure></section></main></template><template data-route="/projects/pdf-pro"><main style="--r22-top:#16202a;--r22-bottom:#25303c" class="sg3-page sg3-product r19-pc-proof" data-design-family="document" id="main"><section aria-label="문서 편집·변환 제품 소개" class="inner-hero project-hero r19-proof-hero r20-product-stage"><div class="sg3-hero-copy"><a href="#/programs/pc#editing">← PC 프로그램 목록</a><p class="eyebrow"><span></span>문서 변환<!-- --> · <!-- -->정식 배포</p><h1>Sunrise PDF PRO</h1><p>대형 HWP/HWPX 보고서의 변환·검수·병합·제출 패키지를 자동화합니다.</p><div class="project-actions"><a class="button primary-download" href="https://github.com/Peter-msk/Sunrise_PDF-PRO/releases/download/v2.7.1/Sunrise_PDF_PRO.exe">프로그램 다운로드 ↓</a><a class="button secondary-service" href="https://sunrise-pdf-pro-web.ko-pg.workers.dev/" rel="noopener noreferrer" target="_blank">웹 버전 바로가기 ↗</a></div></div><section class="r12-hero-proof r20-visual-stage" id="screens"><h2>실제 실행 화면</h2><figure><a aria-label="Sunrise PDF PRO 실행 화면 크게 보기 (새 창)" class="screen-full-link" data-image="true" href="data:image/png;base64," rel="noopener noreferrer" target="_blank"><img alt="Sunrise PDF PRO 실제 실행 화면" src="data:image/png;base64,"/><span>화면 크게 보기 ↗</span></a><figcaption>사용자가 제공한 PDF PRO v3.0 개발 버전의 실행 화면입니다.</figcaption></figure></section></section><nav aria-label="제품 안내 바로가기" class="r07-product-sections r19-product-jump"><a href="#/projects/pdf-pro#screens">실제 실행 화면</a><a href="#/projects/pdf-pro#specifications">제품 정보</a><a href="#/projects/pdf-pro#features">주요 기능과 배포</a><a href="#/projects/pdf-pro#function-motion">기능 모션</a></nav><section class="section project-quick r19-specs" id="specifications"><div><span>이용 형태</span><strong>단일 실행 파일</strong></div><div><span>지원 환경</span><strong>Windows 10 / 11 · 64비트</strong></div><div><span>배포 버전</span><strong>v2.7.1</strong></div></section><p class="distribution-note">배포 정보 확인: <!-- -->2026.11.17<!-- --> · <!-- -->일부 한글 문서 변환에는 한컴 프로그램과 PDF 출력 환경이 필요할 수 있습니다.</p><section class="section project-detail-grid r19-feature-spread r20-feature-layout" id="features"><div><p class="section-kicker">버전과 개발 상태</p><h2>배포와 개발 현황</h2><div class="status-box"><small>배포 정보</small><strong>v2.7.1</strong></div><a class="detail-help" href="#/help">이용 안내 보기 →</a></div><div><p class="section-kicker">주요 기능</p><h2>주요 업무와 기능</h2><p class="detail-text">여러 HWP·HWPX 문서를 PDF로 일괄 변환합니다. 변환 대상과 문서 순서를 먼저 확인해 보고서 묶음을 준비합니다.</p><p class="detail-text">논리 페이지, A3 용지와 컬러 등 변환 품질을 검수합니다. 제출 전 확인이 필요한 페이지와 결과 자료를 함께 정리합니다.</p><p class="detail-text">중단된 작업의 이어하기와 PDF 병합·책갈피 구성을 지원합니다. 최종 병합본과 검수 자료를 제출 패키지로 연결합니다.</p><p class="detail-text"><strong>활용 예시: </strong>대형 보고서 제출: 장별 한글 문서를 변환하고 품질을 확인한 뒤 하나의 PDF로 병합합니다.</p><ul class="feature-list"><li><span>0<!-- -->1</span>HWP/HWPX 대량 PDF 변환</li><li><span>0<!-- -->2</span>논리 페이지·A3·컬러 품질검수</li><li><span>0<!-- -->3</span>이어하기·병합·책갈피·제출 패키지</li></ul></div></section><section aria-label="기능 설명 모션" class="r12-function-block r19-workflow" id="function-motion"><div><p class="section-kicker">작업 과정</p><h2>문서 변환·검수 흐름</h2><p>HWP/HWPX 문서를 입력해 변환과 품질검수를 거쳐 PDF 제출 자료로 구성하는 과정을 표현합니다.</p></div><figure class="sg3-scene r04-scene" data-scene="/projects/pdf-pro"><canvas aria-hidden="true" height="600" width="900"></canvas><figcaption class="r22-caption"><div class="r22-caption-copy"><strong>변환·품질검수·제출</strong><span>기능 설명용 모션 · 실제 실행 화면 아님</span></div><div class="r22-controls"><span class="r22-render-mode" aria-live="polite"></span><button aria-pressed="false" class="sg3-pause" type="button">모션 정지</button></div></figcaption></figure></section></main></template><template data-route="/projects/eiass"><main style="--r22-top:#16202a;--r22-bottom:#25303c" class="sg3-page sg3-product r19-pc-proof" data-design-family="workspace" id="main"><section aria-label="환경·사업 업무 제품 소개" class="inner-hero project-hero r19-proof-hero r20-product-stage"><div class="sg3-hero-copy"><a href="#/programs/pc#environment">← PC 프로그램 목록</a><p class="eyebrow"><span></span>환경영향평가<!-- --> · <!-- -->정식 배포</p><h1>Sunrise EIASS</h1><p>EIASS 사업 검색부터 사업개요·원문 문서 검토까지 한 화면에서 처리합니다.</p><div class="project-actions"><a class="button primary-download" href="https://github.com/Peter-msk/Sunrise-EIASS/releases/download/v4.7.0/Sunrise.EIASS.exe">프로그램 다운로드 ↓</a></div></div><section class="r12-hero-proof r20-visual-stage" id="screens"><h2>실제 실행 화면</h2><figure><a aria-label="Sunrise EIASS 실행 화면 크게 보기 (새 창)" class="screen-full-link" data-image="true" href="data:image/png;base64," rel="noopener noreferrer" target="_blank"><img alt="Sunrise EIASS 실제 실행 화면" src="data:image/png;base64,"/><span>화면 크게 보기 ↗</span></a><figcaption>사용자가 제공한 Sunrise EIASS v4.7.0 실행 화면입니다.</figcaption></figure><details class="r17-more-screens"><summary>추가 실행 화면 보기</summary><div class="screen-grid extra-screens"><figure><a aria-label="작성 가이드라인 조회 화면 크게 보기 (새 창)" class="screen-full-link" data-image="true" href="data:image/png;base64,