<!DOCTYPE html>

<html lang="ko"><head><meta charset="utf-8"/><meta content="width=device-width, initial-scale=1" name="viewport"/><title>Sunrise Group</title><meta content="Sunrise Group의 목표와 개발 원칙, PC 프로그램 및 QGIS 플러그인 소개" name="description"/><style id="sunrise-design-system-r24">/* Sunrise R19. New presentation layer. R18 data, routes, and renderer retained. */
:root{--ink:#182525;--muted:#53615e;--line:#d6dcd7;--paper:#f8f7f2;--white:#fff;--accent:#a3492b;--green:#164b40;--deep:#0d211e;--max:1320px;--pad:clamp(22px,5vw,82px);--header:72px;--serif:Georgia,'Noto Serif KR','NanumMyeongjo',serif;--sans:'Pretendard','Noto Sans KR','Noto Sans CJK KR','Malgun Gothic',Arial,sans-serif}
*,*::before,*::after{box-sizing:border-box}html{scroll-padding-top:calc(var(--header) + 20px);color-scheme:light}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.72 var(--sans);word-break:keep-all;overflow-wrap:anywhere}main{display:block;outline:none}h1,h2,h3,p,figure{margin:0}h1,h2,h3{line-height:1.23;letter-spacing:-.045em;font-weight:650}a{color:inherit;text-decoration:none}a:hover{color:var(--accent)}button,input{font:inherit}button,summary{cursor:pointer}button{color:inherit}img,canvas,svg{display:block;max-width:100%}img{height:auto}figure{min-width:0}ul{margin:0;padding:0;list-style:none}[hidden]{display:none!important}a:focus-visible,button:focus-visible,input:focus-visible,summary:focus-visible{outline:3px solid #b96832;outline-offset:4px}main:focus{outline:none}a,button{touch-action:manipulation}p{max-width:76ch}.skip-link{position:absolute;left:12px;top:-90px;background:white;padding:12px;z-index:100}.skip-link:focus{top:8px}
/* Header / navigation: calm typographic wordmark, independently controlled submenus. */
.site-header{position:sticky;top:0;z-index:50;height:var(--header);display:flex;align-items:center;justify-content:space-between;gap:24px;padding:0 var(--pad);background:#f8f7f2;color:var(--ink);border-bottom:1px solid #cdd2cb}.brand{display:inline-flex;align-items:center;gap:10px;white-space:nowrap;font-family:Arial,var(--sans);font-size:23px;font-weight:700;letter-spacing:-.055em;line-height:1.1}.brand-mark{width:34px;height:34px;flex:none}.brand-mark svg{width:100%;height:100%}.desktop-nav{display:flex;height:100%;align-items:center;gap:clamp(16px,3vw,50px)}.r07-nav-program{display:flex;position:relative;align-items:center;gap:0;height:100%}.nav-card{display:flex;align-items:center;min-height:46px;position:relative;font-size:15px}.nav-card strong{font-weight:600}.nav-card[aria-current]{color:var(--accent)}.nav-card[aria-current]::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;background:currentColor}.r07-nav-toggle{border:0;background:none;display:grid;place-items:center;min-width:44px;min-height:44px;padding:0}.r07-nav-toggle svg{width:16px;height:16px}.r07-submenu{position:absolute;top:calc(100% - 1px);right:0;width:255px;background:#fff;color:var(--ink);padding:8px 16px;border:1px solid var(--line);box-shadow:0 12px 24px #00000015}.r07-submenu a{display:block;padding:13px 5px;border-bottom:1px solid var(--line)}.r07-submenu a:last-child{border:0}.r07-submenu strong,.r07-submenu small{display:block}.r07-submenu small{font-size:12px;color:var(--muted);margin-top:4px}.mobile-menu{display:none}.sg-wayfinding{background:var(--paper);color:var(--muted);font-size:12px}.sg-wayfinding>div{max-width:var(--max);margin:auto;padding:12px var(--pad);display:flex;gap:9px;align-items:center;flex-wrap:wrap}.sg-wayfinding a{text-decoration:underline;text-underline-offset:3px}.sg-wayfinding .sg-location{color:var(--ink)}.sg-read-progress{display:none}body:has(#page-outlet[data-route="/"]) .sg-wayfinding{display:none}body:has(#page-outlet[data-route="/"]) .site-header{background:#0c1014;color:#f5f3ed;border-color:#ffffff25}body:has(#page-outlet[data-route="/"]) .nav-card[aria-current]{color:#f1b07e}
/* A — entire stage is a single visual composition, not a two-column card. */
.r19-cinema{position:relative;isolation:isolate;min-height:calc(100svh - var(--header));display:grid;grid-template-rows:auto minmax(300px,1fr) auto;overflow:hidden;background:#0c1014;color:#fbf8f0;padding:clamp(36px,5vw,72px) var(--pad) 30px}.r19-cinema-title{z-index:2;margin:0 auto;width:100%;max-width:var(--max);text-align:center}.r19-cinema h1{font-family:Arial,var(--sans);font-size:clamp(64px,11.7vw,180px);font-weight:400;letter-spacing:-.09em;line-height:.87;white-space:normal}.r19-cinema-world{position:relative;min-height:0;width:100%;max-width:1100px;margin:0 auto;align-self:center}.r19-cinema-world figure{position:relative;display:flex;flex-direction:column;align-items:center}.r19-cinema-world canvas{width:min(100%,104vh);aspect-ratio:3/2;height:auto;max-width:100%;margin:-1.8vw auto -2.2vw;mask-image:radial-gradient(ellipse 67% 70% at center,#000 55%,transparent 100%);-webkit-mask-image:radial-gradient(ellipse 67% 70% at center,#000 55%,transparent 100%)}.r19-cinema-world figcaption{position:absolute;right:0;bottom:12px;display:flex;flex-direction:column;align-items:flex-end;gap:10px;font-size:12px;color:#c6cbc9;z-index:3}.r11-art-label{display:flex;gap:9px;align-items:center}.r11-art-label strong{font-weight:600;color:white}.r11-art-label i{height:6px;width:6px;background:#e5b17e;border-radius:50%}.r11-legend{position:absolute;left:0;bottom:20px;display:flex;gap:15px;font-size:12px;color:#bfc7c5;z-index:3}.r11-legend span{display:flex;align-items:center;gap:5px}.r11-legend i{background:var(--dot);width:7px;height:7px;border-radius:50%}.sg3-pause{background:transparent;border:1px solid currentColor;min-height:44px;min-width:92px;padding:9px 15px;font-size:12px;font-weight:600;line-height:1.25}.r19-cinema .sg3-pause:hover{background:#ffffff18;color:#fff}.r19-cinema-bottom{width:100%;max-width:var(--max);margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:32px;align-items:end;border-top:1px solid #ffffff35;padding-top:24px;z-index:3}.r10-home-copy{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1fr);gap:16px 36px;align-items:start}.r07-home-lead{font-size:clamp(21px,2.5vw,36px);font-weight:600;letter-spacing:-.045em;line-height:1.4}.vision-lead{color:#c9d0d0;font-size:15px;line-height:1.7;max-width:40ch}.home-actions{grid-column:1/-1}.primary-action,.inline-next,.about-next a,.editorial-next a,.detail-help{display:inline-flex;align-items:center;gap:8px;font-weight:650;font-size:14px;min-height:44px;text-decoration:underline;text-underline-offset:5px}.r19-cinema a{color:white}.r07-scroll{display:inline-flex;align-items:center;gap:14px;font-size:13px;min-height:44px;border-bottom:1px solid #ffffff65;white-space:nowrap}.r07-scroll span{font-size:22px;font-weight:300}
/* A — editorial story below the cinematic opening. */
.r19-story{display:grid;grid-template-columns:minmax(120px,1fr) minmax(0,3fr);gap:clamp(28px,7vw,120px);max-width:var(--max);padding:clamp(68px,10vw,140px) var(--pad);margin:auto}.r07-section-label,.section-kicker,.eyebrow{font-size:12px;letter-spacing:.065em;font-weight:650;color:var(--accent);margin-bottom:16px}.r19-story h2{font-size:clamp(38px,5.3vw,77px);font-weight:500;max-width:16ch;line-height:1.24}.r19-story p{font-size:clamp(16px,1.45vw,21px);margin:28px 0;color:#43534e}.r19-values-section{background:#dfe5dc;padding:clamp(50px,7vw,100px) var(--pad);display:grid;grid-template-columns:1fr 2.2fr;gap:clamp(30px,7vw,110px)}.r19-values-section>div:first-child h2{font-size:clamp(32px,4.3vw,64px);font-weight:500;margin-bottom:14px}.r07-values{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.r07-values article{border-top:2px solid var(--green);padding-top:20px}.r07-values h3{font-size:23px;margin-bottom:10px}.r07-values p{font-size:15px;color:var(--muted)}.r07-values .inline-next{grid-column:1/-1}.r19-end{background:#e9be97;color:#211e19;padding:clamp(52px,8vw,112px) var(--pad);display:grid;grid-template-columns:1fr 1fr;gap:24px 80px;align-items:center}.r19-end h2{font-size:clamp(42px,6vw,90px);font-weight:500}.r19-end p{font-size:20px}.r19-end .inline-next{grid-column:2;justify-self:start}
/* Base inner pages */
.sg3-page{background:var(--paper)}.inner-hero{padding:clamp(44px,6vw,90px) var(--pad);max-width:var(--max);margin:0 auto}.sg3-hero-copy{min-width:0}.inner-hero h1{font-size:clamp(39px,5.4vw,78px);font-weight:500;line-height:1.19;max-width:22ch}.sg3-hero-copy>p:not(.eyebrow){margin-top:20px;font-size:clamp(16px,1.4vw,20px);color:var(--muted);max-width:42ch}.section{max-width:var(--max);margin:0 auto;padding:40px var(--pad) 64px}.section h2{font-size:clamp(26px,2.8vw,40px)}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:16px;margin-bottom:28px}.section-heading p{color:var(--muted);font-size:14px}.section-kicker{margin-bottom:10px}.editorial-next,.about-next,.callout{border-top:1px solid var(--line);margin-top:40px;padding:28px 0;display:flex;align-items:center;justify-content:space-between;gap:20px}.editorial-next p,.about-next p{font-size:17px;color:var(--muted)}.r19-editorial-index{display:flex;max-width:var(--max);margin:auto;padding:0 var(--pad);gap:24px;align-items:center;border-bottom:1px solid var(--line)}.r19-editorial-index a{padding:14px 0;min-height:44px;font-size:14px}.r19-editorial-index a[aria-current]{border-bottom:2px solid var(--accent);color:var(--accent);font-weight:650}
/* Corporate art direction — differentiated shapes and page flow. */
.r19-editorial-about .inner-hero{max-width:none;background:#e8c29d;padding-top:clamp(65px,9vw,140px);padding-bottom:clamp(65px,9vw,140px)}.r19-editorial-about .sg3-hero-copy{max-width:var(--max);margin:auto;display:grid;grid-template-columns:2fr 1fr;gap:20px 70px;align-items:end}.r19-editorial-about .eyebrow{grid-column:1/-1;color:#553b2d}.r19-editorial-about h1{font-size:clamp(55px,8.2vw,112px);max-width:10ch}.r19-editorial-about .sg3-hero-copy>p:not(.eyebrow){color:#44372d;font-size:22px;margin:0}.about-section{display:grid;grid-template-columns:1fr 1.3fr;gap:clamp(32px,8vw,125px);max-width:var(--max);margin:auto;padding:clamp(60px,9vw,112px) var(--pad)}.about-title h2{font-size:clamp(35px,4.7vw,66px);font-weight:500}.about-copy p{margin-bottom:20px;font-size:17px;color:var(--muted)}.about-copy .lead{font-size:22px;color:var(--ink)}.about-bridge{display:grid;grid-template-columns:1fr 1fr;gap:0;max-width:var(--max);margin:auto;padding:0 var(--pad)}.about-bridge>div{background:#e9e9df;padding:38px}.about-bridge>div:nth-child(2){background:#d7e6da}.about-bridge span{font-size:12px;color:var(--muted)}.about-bridge h3{font-size:30px;margin:16px 0}.about-bridge p{font-size:15px}.about-next{max-width:var(--max);padding:28px var(--pad);margin:35px auto 0}.r19-editorial-principles .inner-hero{max-width:none;background:#192c29;color:#fff;padding-top:80px;padding-bottom:85px}.r19-editorial-principles .sg3-hero-copy{max-width:var(--max);margin:auto}.r19-editorial-principles .eyebrow{color:#e9ba91}.r19-editorial-principles .inner-hero h1{color:#fff;max-width:16ch}.r19-editorial-principles .sg3-hero-copy>p:not(.eyebrow){color:#d8e4dc}.editorial-intro{display:grid;grid-template-columns:1fr 3fr;gap:24px;padding:18px 0 44px}.editorial-intro>p:not(.section-kicker){font-size:clamp(22px,3vw,38px);line-height:1.4;letter-spacing:-.04em;max-width:30ch}.principle-grid{display:grid;grid-template-columns:1fr 1fr;gap:2px;background:#b6c0b6}.principle-grid article{padding:clamp(26px,4vw,60px);background:#f0f1e8;min-height:220px}.principle-grid article:nth-child(2),.principle-grid article:nth-child(3){background:#e3e8dc}.principle-grid article>span{display:block;font:36px/1 var(--serif);color:#92613b;margin-bottom:24px}.principle-grid h3{font-size:29px;margin-bottom:12px}.principle-grid p{color:var(--muted);font-size:16px}.r19-editorial-future .inner-hero{max-width:none;background:#e4e8db}.r19-editorial-future .sg3-hero-copy{max-width:var(--max);margin:auto}.future-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}.future-grid article{border-top:2px solid var(--green);padding:28px 0;min-width:0}.future-grid article>span{font-size:14px;color:var(--accent);white-space:nowrap}.future-grid h3{font-size:clamp(22px,2.6vw,34px);margin:28px 0 16px;max-width:13ch}.future-grid p{font-size:16px;color:var(--muted)}
/* B — real product exhibition, independent from the cinematic home. */
.r19-portal-page .inner-hero{padding-bottom:35px}.r19-portal-page .program-catalog{padding-top:15px}.r05-portal-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}.r05-portal{min-width:0;background:#e8eae5;display:flex;flex-direction:column;overflow:hidden}.r05-portal:nth-child(2){background:#dce8dc}.r19-portal-visual{background:#dce1dc;min-width:0;aspect-ratio:1.7;display:flex;flex-direction:column;justify-content:center;position:relative}.r19-portal-visual img{width:100%;height:100%;object-fit:contain;padding:18px}.r05-portal:nth-child(2) .r19-portal-visual{background:#1c372c}.r05-portal:nth-child(2) img{padding:0}.r19-portal-visual span{position:absolute;bottom:5px;left:12px;font-size:11px;background:#fbfaf4;color:#233b30;padding:3px 8px}.r05-portal>div:not(.r19-portal-visual){padding:30px}.r05-portal small{color:var(--muted);font-size:13px}.r05-portal h3{font-size:clamp(29px,4vw,52px);margin:12px 0}.r05-portal p{font-size:16px;color:var(--muted)}.r05-portal b{display:block;margin-top:24px;font-size:14px;color:var(--green)}
.r19-product-gallery .inner-hero{max-width:none;background:#e5e8e5;display:grid;grid-template-columns: .85fr 1.35fr;gap:clamp(30px,5vw,80px);align-items:center;padding-top:clamp(45px,6vw,88px);padding-bottom:clamp(38px,5vw,72px)}.r19-product-gallery .inner-hero h1{font-size:clamp(50px,6.4vw,92px)}.r19-showcase-art{min-width:0}.r19-showcase-art a{display:block;background:#fff;padding:10px;box-shadow:0 22px 50px #25382f24}.r19-showcase-art img{width:100%;max-height:380px;object-fit:contain;object-position:center}.r19-showcase-art a span{padding:14px 8px 5px;font-size:19px;font-weight:650;display:flex;justify-content:space-between;align-items:center;gap:12px}.r19-showcase-art a b{font-size:12px;color:var(--accent);white-space:nowrap}.r19-showcase-art figcaption{font-size:11px;color:var(--muted);margin-top:10px}
/* D — geospatial atlas. The terrain is the cover; grouping is an actual atlas spread. */
.r19-atlas .inner-hero{max-width:none;background:#17392e;color:#fff;display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.35fr);gap:20px;align-items:center;padding-top:24px;padding-bottom:24px}.r19-atlas .inner-hero h1{font-size:clamp(48px,6.2vw,88px);max-width:11ch}.r19-atlas .eyebrow{color:#c1d9c4}.r19-atlas .sg3-hero-copy>p:not(.eyebrow){color:#d6e6d8;font-size:19px}.r19-atlas-art{position:relative;overflow:hidden}.r19-atlas-art img{width:100%;max-height:440px;object-fit:contain;mask-image:radial-gradient(ellipse 69% 70%,#000 59%,transparent 100%)}.r19-atlas-art figcaption{font-size:11px;color:#d4e4d6;text-align:right;margin-top:4px}.r19-atlas .program-catalog{background:#f0f2e9}.r19-atlas-group{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.65fr);gap:30px;padding:34px 0;border-top:2px solid #486c58}.r19-group-art{margin-top:20px}.r19-group-art img{width:100%;aspect-ratio:3/2;object-fit:cover}.r19-group-art figcaption{color:var(--muted);font-size:11px;margin-top:5px}
/* Catalogue toolbar, links, gallery; search retains original selectors. */
.program-catalog{padding-top:27px;padding-bottom:68px}.r19-catalog-toolbar{display:flex;align-items:flex-end;justify-content:space-between;gap:30px;margin-bottom:24px}.r05-branch-nav{display:flex;gap:22px;flex-wrap:wrap}.r05-branch-nav a{display:flex;gap:9px;align-items:center;min-height:46px;font-size:17px;border-bottom:2px solid transparent}.r05-branch-nav a[aria-current]{font-weight:650;border-color:var(--green);color:var(--green)}.r05-branch-nav span{font-size:12px;color:var(--muted)}.r07-catalog-tools{width:min(100%,460px)}.r07-catalog-tools label{display:block;font-size:12px;color:var(--muted);margin-bottom:4px}.r07-search-row{display:flex;align-items:center;gap:12px}.r07-search-row input{width:100%;min-width:0;min-height:48px;border:1px solid #8d9b91;background:white;color:var(--ink);padding:9px 13px;border-radius:0}.r07-result{white-space:nowrap;font-size:12px;color:var(--muted)}.r07-catalog-side{position:relative;padding:10px 0 16px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin-bottom:30px}.r07-catalog-side h2{font-size:12px;letter-spacing:.04em;color:var(--muted);font-weight:600;margin:6px 0}.r05-group-nav{display:flex;flex-wrap:wrap;gap:4px 22px}.r07-category-link{display:flex;align-items:center;gap:8px;font-size:14px;min-height:44px}.r07-category-link span{font-size:11px;color:var(--muted)}.r07-category-link:hover{color:var(--accent)}.catalog-group-heading h3{font-size:clamp(23px,3.1vw,39px);font-weight:550;line-height:1.24}.catalog-group-heading p{font-size:14px;color:var(--muted);margin-top:10px}.r19-gallery-group{padding:28px 0 42px;border-top:2px solid #253a32}.r19-gallery-group .catalog-group-heading{display:flex;justify-content:space-between;align-items:end;gap:25px;margin-bottom:20px}.r19-gallery-group .catalog-lines{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.catalog-line{display:grid;min-width:0;position:relative;background:#fff;color:var(--ink);padding:22px;gap:12px;border:1px solid var(--line);align-content:start;transition:border-color .2s,transform .2s}.catalog-line:hover{border-color:#6c8878;color:var(--ink);transform:translateY(-2px)}.catalog-line-name small{font-size:11px;color:var(--muted)}.catalog-line-name h3{font-size:21px;font-weight:650;margin:5px 0;overflow-wrap:anywhere}.catalog-line>p{font-size:14px;color:#465951;line-height:1.65}.catalog-line-meta{display:flex;align-items:center;flex-wrap:wrap;gap:7px 12px;font-size:12px;align-self:end;margin-top:6px;padding-right:20px}.catalog-line-meta small{font-size:11px;color:var(--muted)}.catalog-arrow{position:absolute;right:17px;bottom:16px;font-size:23px;line-height:1;color:var(--accent)}.sg3-product-object{order:-1;display:flex;flex-direction:column;gap:5px;min-width:0;background:#edf0eb;padding:8px}.sg3-product-object img{width:100%;aspect-ratio:1.78;object-fit:contain}.r07-preview-label{font-size:10px;color:var(--muted);text-align:right}.catalog-line:not(.r07-real-preview) .sg3-product-object{display:none}.r19-gallery-group .r08-text-row{background:#f3f2ec;align-content:center;min-height:205px}.r19-atlas-group .catalog-lines{display:flex;flex-direction:column;gap:0}.r19-atlas-group .catalog-line{background:transparent;border:0;border-bottom:1px solid #aebfb0;display:grid;grid-template-columns:1fr auto;gap:7px 16px;padding:18px 24px 20px 0}.r19-atlas-group .catalog-line:hover{transform:none;background:#e5ece0}.r19-atlas-group .catalog-line-name{grid-column:1/-1}.r19-atlas-group .catalog-line>p{grid-column:1/-1;max-width:65ch}.r19-atlas-group .catalog-line-meta{grid-column:1/-1}.r19-atlas-group .catalog-arrow{right:0;bottom:17px;color:var(--green)}.r08-state[data-status="complete"]{color:#216243!important}.r08-state[data-status="active"]{color:#8a4b23!important}.r08-state[data-status="stopped"]{color:#626b67!important}.r07-no-results{padding:30px;border:1px solid var(--line);background:white}
/* Product detail: three different stage layouts. */
