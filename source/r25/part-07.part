 gl.enable(gl.DEPTH_TEST);gl.depthFunc(gl.LEQUAL);gl.enable(gl.BLEND);gl.blendFunc(gl.SRC_ALPHA,gl.ONE_MINUS_SRC_ALPHA);gl.useProgram(main.p);mat(main,'uVP',s.camera);mat(main,'uLightVP',s.lightVP);v3(main,'uEye',s.eye);v3(main,'uLight',s.light);i(main,'uHome',+s.home);f(main,'uTime',t);f(main,'uAmbient',s.ambient);gl.activeTexture(gl.TEXTURE1);gl.bindTexture(gl.TEXTURE_2D,shadowTex);i(main,'uShadow',1);i(main,'uAtlas',0);gl.activeTexture(gl.TEXTURE2);gl.bindTexture(gl.TEXTURE_2D,environment);i(main,'uEnvironment',2);gl.activeTexture(gl.TEXTURE0);
