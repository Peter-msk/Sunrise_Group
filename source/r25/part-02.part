const textures=[];
function sphereTexture(i){if(textures[i])return textures[i];const size=192,c=document.createElement('canvas');c.width=c.height=size;const g=c.getContext('2d'),im=g.createImageData(size,size),d=im.data;const cols=[[194,67,42],[185,181,164],[110,154,172],[197,124,89],[183,168,123]];let base=cols[i];
 for(let y=0;y<size;y++)for(let x=0;x<size;x++){let X=(x+.5-size/2)/(size/2-1),Y=(y+.5-size/2)/(size/2-1),q=X*X+Y*Y;if(q>1)continue;let Z=Math.sqrt(1-q),lon=Math.atan2(X,Z),lat=Math.asin(Y),noise=.44*Math.sin(lon*17+Math.sin(lat*13)*3+Math.sin(lon*8-lat*9))*Math.cos(lat*19+Math.sin(lon*13))+.27*Math.cos(lon*37+lat*29+Math.sin(lat*21)*3)+.18*Math.sin(lon*71-lat*58)+.11*Math.cos(lon*113+lat*97),fine=Math.sin(x*53.7+y*79.1)*.5;let light=Math.max(0,-.55*X-.48*Y+.68*Z),k=i===0?.62+.38*light+.045*noise+.014*fine:.23+.87*light;let n=i===4?.22*Math.sin(lat*27+noise*.8):i===2?.23*Math.sin(lon*5+lat*6+noise):.11*noise+.05*fine;let edge=Math.pow(1-Z,4);let a=(y*size+x)*4;for(let j=0;j<3;j++)d[a+j]=clamp(base[j]*(k+n)+(17*edge)+ (i===0?5:0),0,255);d[a+3]=clamp((1-Math.sqrt(q))*size*130,0,255);}
 g.putImageData(im,0,0);textures[i]=c;return c;
}
// R12: procedural sphere surfaces. Cached textures, no image downloads or external GPU dependency.
const r12PlanetCache=new Map();
function r12Hash(x,y,z){let n=Math.imul(x,374761393)+Math.imul(y,668265263)+Math.imul(z,1274126177);n=Math.imul(n^(n>>>13),1274126177);return ((n^(n>>>16))>>>0)/4294967295;}
function r12Value(x,y,z){let X=Math.floor(x),Y=Math.floor(y),Z=Math.floor(z),u=x-X,v=y-Y,w=z-Z;u=u*u*(3-2*u);v=v*v*(3-2*v);w=w*w*(3-2*w);let a=r12Hash(X,Y,Z)*(1-u)+r12Hash(X+1,Y,Z)*u,b=r12Hash(X,Y+1,Z)*(1-u)+r12Hash(X+1,Y+1,Z)*u,c=r12Hash(X,Y,Z+1)*(1-u)+r12Hash(X+1,Y,Z+1)*u,d=r12Hash(X,Y+1,Z+1)*(1-u)+r12Hash(X+1,Y+1,Z+1)*u;return ((a*(1-v)+b*v)*(1-w)+(c*(1-v)+d*v)*w)*2-1;}
function r12Noise(x,y,z){return .56*r12Value(x*2.5+17,y*2.5-9,z*2.5+5)+.28*r12Value(x*5.1-4,y*5.1+7,z*5.1)+.11*r12Value(x*11.6,y*11.6+4,z*11.6-2)+.05*r12Value(x*23.4,y*23.4,z*23.4);}
function r12Sphere(i,lx,ly,lz){let key=[i,Math.round(lx*8),Math.round(ly*8),Math.round(lz*8)].join(',');if(r12PlanetCache.has(key))return r12PlanetCache.get(key);if(r12PlanetCache.size>96)r12PlanetCache.delete(r12PlanetCache.keys().next().value);const size=i===0?512:180,c=document.createElement('canvas');c.width=c.height=size;const g=c.getContext('2d'),img=g.createImageData(size,size),d=img.data;let palettes=[[255,143,42],[165,160,148],[58,124,175],[184,100,66],[201,176,137]];
 for(let y=0;y<size;y++)for(let x=0;x<size;x++){let X=(x+.5-size*.5)/(size*.5-1),Y=(y+.5-size*.5)/(size*.5-1),q=X*X+Y*Y;if(q>1)continue;let Z=Math.sqrt(1-q),n=r12Noise(X*2,Y*2,Z*2),fine=r12Noise(X*9,Y*9,Z*9),dotp=Math.max(0,X*lx+Y*ly+Z*lz),rim=Math.pow(1-Z,3.5),base=palettes[i].slice();let f=.09+.92*Math.pow(dotp,.78);
 if(i===0){let warp=r12Value(X*5+7,Y*5-4,Z*5+3),turb=r12Noise(X*5+warp*1.4,Y*5-warp*1.4,Z*5+warp*.8),gran=r12Value(X*116,Y*116,Z*116);let hot=.51+.36*n+.22*turb+.13*fine+.08*gran;let limb=.64+.36*Z;base=[255,Math.min(250,55+hot*218),Math.min(205,4+hot*118)];f=limb;}
 else if(i===1){f*=.8+.24*n+.13*fine;}
 else if(i===2){if(n+.16*Math.sin(X*6+Y*3)>.11){base=[104+fine*40,137+fine*35,92+fine*20]}if(r12Noise(X*5,Y*4,Z*5)>.34||Math.abs(Y)>.86){base=base.map(v=>v*.3+205*.7)}f*=.95+.06*fine;}
 else if(i===3){f*=.9+.16*n+.12*fine;}
 else if(i===4){let band=.88+.11*Math.sin(Y*35+n*3)+.055*Math.sin(Y*90+n);f*=band;}
 let k=(y*size+x)*4;for(let j=0;j<3;j++)d[k+j]=Math.max(0,Math.min(255,base[j]*f+(i===2?[24,50,76][j]*rim*dotp:5*rim)));d[k+3]=Math.min(255,(1-Math.sqrt(q))*size*130);}
 g.putImageData(img,0,0);r12PlanetCache.set(key,c);return c;
}
let r12StarLayer=null;
function r12Stars(){if(r12StarLayer)return r12StarLayer;let c=document.createElement('canvas');c.width=900;c.height=600;let g=c.getContext('2d'),seed=9827;const rnd=()=>{seed=(seed*1664525+1013904223)>>>0;return seed/4294967296};for(let i=0;i<250;i++){let x=rnd()*900,y=rnd()*600,r=rnd()<.045?1.5:.35+rnd()*.55;let edge=Math.min(1,x/100,(900-x)/100,y/70,(600-y)/70);g.fillStyle=`rgba(210,225,241,${(.12+rnd()*.55)*Math.max(0,edge)})`;g.beginPath();g.arc(x,y,r,0,TAU);g.fill();}return r12StarLayer=c;}
function solar(ctx,t,view=0){
 const cx=455+view*13,cy=302-view*13,tilt=.53+view*.045,rot=-.48+view*.075;ctx.drawImage(r12Stars(),0,0);
 const p=(r,a)=>{const x=r*Math.cos(a),y=r*Math.sin(a)*tilt;return [cx+x*Math.cos(rot)-y*Math.sin(rot),cy+x*Math.sin(rot)+y*Math.cos(rot),Math.sin(a)]};
 const orbits=[{r:135,s:12,spd:.18,a:.74},{r:208,s:27,spd:.125,a:4.45},{r:284,s:20,spd:.087,a:.20},{r:355,s:36,spd:.052,a:2.60}];
 const h=ctx.createRadialGradient(cx,cy,78,cx,cy,255);h.addColorStop(0,'#ff9d364d');h.addColorStop(.22,'#ff7a1e20');h.addColorStop(.58,'#de5c0b09');h.addColorStop(1,'#ed6c1300');ctx.fillStyle=h;ctx.fillRect(0,0,900,600);
 function trace(o,front){ctx.beginPath();for(let j=0;j<=120;j++){let a=(front?0:Math.PI)+j*Math.PI/120,[x,y]=p(o.r,a);j?ctx.lineTo(x,y):ctx.moveTo(x,y)}ctx.strokeStyle=front?'#a6b2c44d':'#a6b2c423';ctx.lineWidth=front?1.1:.8;ctx.stroke()}
 function ring(x,y,r,front){ctx.save();ctx.translate(x,y);ctx.rotate(-.48);for(let i=0;i<7;i++){ctx.strokeStyle=['#cbbca77a','#cfbf9d99','#b29c7d80','#b7a58755','#e1cdb1bb','#9b8a7277','#bba8896c'][i];ctx.lineWidth=[2,2.5,1.8,1,2.5,1.4,1][i];ctx.beginPath();ctx.ellipse(0,0,r*(1.45+i*.12),r*(.37+i*.03),0,front?0:Math.PI,front?Math.PI:TAU);ctx.stroke()}ctx.restore()}
 const planets=orbits.map((o,i)=>({...o,i:i+1,pos:p(o.r,o.a+t*o.spd)}));
 function planet(o){let [x,y,z]=o.pos,r=o.s*(1+.10*z),dx=cx-x,dy=cy-y,dl=Math.hypot(dx,dy)||1;let lx=Math.round(dx/dl*.85*8)/8,ly=Math.round(dy/dl*.85*8)/8,lz=.39;if(o.i===4)ring(x,y,r,false);ctx.drawImage(r12Sphere(o.i,lx,ly,lz),x-r,y-r,2*r,2*r);if(o.i===4)ring(x,y,r,true)}
 orbits.forEach(o=>trace(o,false));planets.filter(o=>o.pos[2]<0).sort((a,b)=>a.pos[2]-b.pos[2]).forEach(planet);
 // A thin luminous limb and broad corona communicate a self-luminous star, not a painted ball.
 ctx.save();ctx.shadowColor='#ff8b2ba6';ctx.shadowBlur=32;ctx.drawImage(r12Sphere(0,0,0,1),cx-103,cy-103,206,206);ctx.restore();ctx.beginPath();ctx.arc(cx,cy,102,0,TAU);ctx.strokeStyle='#ffcf8b9c';ctx.lineWidth=1.6;ctx.stroke();
 orbits.forEach(o=>trace(o,true));planets.filter(o=>o.pos[2]>=0).sort((a,b)=>a.pos[2]-b.pos[2]).forEach(planet);
}
function rr(g,x,y,w,h,r,fill,stroke){g.beginPath();g.roundRect(x,y,w,h,r);if(fill){g.fillStyle=fill;g.fill()}if(stroke){g.strokeStyle=stroke;g.lineWidth=1;g.stroke()}}
function line(g,arr,c,w=1){g.beginPath();arr.forEach(([x,y],i)=>i?g.lineTo(x,y):g.moveTo(x,y));g.strokeStyle=c;g.lineWidth=w;g.lineJoin='round';g.lineCap='round';g.stroke()}
function dot(g,x,y,r,c){g.beginPath();g.arc(x,y,r,0,TAU);g.fillStyle=c;g.fill()}
function text(g,s,x,y,size=12,color='#9baec0',align='left',bold=false){g.font=`${bold?'600 ':''}${size}px 'Malgun Gothic', 'Noto Sans CJK KR', sans-serif`;g.fillStyle=color;g.textAlign=align;g.fillText(s,x,y)}
function rows(g,x,y,w,n,c){for(let i=0;i<n;i++){rr(g,x,y+i*13,w*(i%3===2?.66:1),4,2,c)}}
function doc(g,x,y,w,h,label,accent,lines=true){rr(g,x+4,y+5,w,h,5,'#0005');rr(g,x,y,w,h,5,'#dae3e9','#f4f8fc');rr(g,x+9,y+10,w-18,17,3,accent);text(g,label,x+w/2,y+23,10,'#0e1923','center',true);if(lines){rows(g,x+10,y+38,w-20,Math.floor((h-39)/13),'#8299aa');}}
function mapArt(g,x,y,w,h,accent,kind,t){rr(g,x,y,w,h,7,'#1b393a','#52716d');g.save();g.beginPath();g.roundRect(x,y,w,h,7);g.clip();for(let k=0;k<9;k++){g.beginPath();for(let j=0;j<=32;j++){const X=x+j*w/32,Y=y+k*h/8+Math.sin(j*.24+k*.6)*h*.13+Math.cos(j*.45+k*.39)*h*.045;j?g.lineTo(X,Y):g.moveTo(X,Y)}g.strokeStyle='#6c9b8580';g.lineWidth=.8;g.stroke()}line(g,[[x-3,y+h*.8],[x+w*.24,y+h*.47],[x+w*.54,y+h*.50],[x+w*.78,y+h*.1],[x+w+5,y+h*.3]],'#aad4f7a6',3);line(g,[[x+w*.1,y+h*.1],[x+w*.38,y+h*.27],[x+w*.65,y+h*.72],[x+w*.9,y+h*.83]],'#d2c2a48c',1.6);if(kind==='analysis'||kind==='layers'){g.fillStyle='#79c1b84b';g.strokeStyle='#bce9bc';g.beginPath();g.moveTo(x+w*.26,y+h*.32);g.lineTo(x+w*.64,y+h*.15);g.lineTo(x+w*.81,y+h*.64);g.lineTo(x+w*.45,y+h*.83);g.closePath();g.fill();g.stroke()}
 const px=x+w*.55,py=y+h*.48;dot(g,px,py,10+Math.sin(t*2)*2,'#c5e6b72b');dot(g,px,py,4,accent);g.restore()}
function graph(g,x,y,w,h,accent){for(let i=0;i<4;i++)line(g,[[x,y+i*h/3],[x+w,y+i*h/3]],'#a8b9c323');const vals=[.31,.64,.44,.83,.68,.96];for(let i=0;i<6;i++)rr(g,x+i*w/6+3,y+h-h*vals[i],w/6-8,h*vals[i],2,i===5?accent:'#64899e');}
function art(g,type,accent,t){const a=accent;const W=180,H=130;rr(g,0,0,W,H,8,'#111c26','#5d718163');
 const toolbar=(title)=>{rr(g,0,0,W,23,7,'#263743');[0,1,2].forEach(i=>dot(g,10+i*8,11,2.2,i===0?a:'#8296a4'));text(g,title,38,15,10,'#ebeff2')};
 const check=(x,y)=>{dot(g,x,y,6,'#326a5a');line(g,[[x-3,y],[x-1,y+3],[x+4,y-3]],'#caf0d4',1.8)};
 const arrow=(x,y)=>{line(g,[[x-9,y],[x+9,y],[x+4,y-5]],a,2);line(g,[[x+9,y],[x+4,y+5]],a,2)};
 const list=(labels,title='자료 목록')=>{toolbar(title);labels.forEach((s,i)=>{rr(g,10,32+i*28,160,23,4,i===Math.floor(t*.7)%labels.length?'#344b59':'#1b2a35');dot(g,20,43+i*28,3,i===0?a:'#678697');text(g,s,31,47+i*28,10,'#e0e7ed');});};
 switch(type){
 case 'pdf':case 'hwp':case 'package':case 'guide':case 'compare':case 'edit':case 'convert':case 'browserpdf':case 'browserout':case 'browserupload':{
 let web=type.startsWith('browser');if(web)toolbar(type==='browserupload'?'파일 열기':type==='browserout'?'결과':'PDF 편집');let yy=web?30:12;
 if(type==='compare'){doc(g,12,yy,67,103,'A',a);doc(g,101,yy,67,103,'B',a);line(g,[[22,yy+63],[68,yy+63]],'#b45743',3);line(g,[[112,yy+76],[158,yy+76]],'#639982',3)}
 else if(type==='convert'||type==='browserupload'){doc(g,12,yy,62,89,'HWP',a);arrow(91,yy+42);doc(g,110,yy,58,89,'PDF','#f0a387')}
 else if(type==='edit'||type==='browserpdf'){doc(g,23,yy,104,105-(web?12:0),'PDF',a);rr(g,36,yy+53,68,12,2,'#e6b77b85');line(g,[[55,yy+78],[103,yy+78],[103,yy+65]],'#9c503c',2);rr(g,139,yy+9,24,77,4,'#354957');['T','□','↗'].forEach((v,i)=>text(g,v,151,yy+28+i*21,14,'#e8eef5','center',true))}
 else {doc(g,51,yy+4,75,102-(web?15:0),type==='hwp'?'HWPX':type==='guide'?'이용 안내':'PDF',a);if(type==='package'){doc(g,18,yy+11,68,91,'01',a);doc(g,97,yy+11,68,91,'03',a);doc(g,55,yy,70,107,'PDF',a)}if(type==='legal'){text(g,'요구사항',90,124,9,a,'center')}}break;}
 case 'map':case 'layers':case 'analysis':case 'pin':case 'field':case 'plume':case 'stack':case 'blueprint':{
 if(type==='blueprint'){toolbar('도면');for(let i=0;i<8;i++)line(g,[[12+i*20,30],[12+i*20,122]],'#446b8855');for(let i=0;i<5;i++)line(g,[[10,36+i*19],[170,36+i*19]],'#446b8855');line(g,[[32,103],[32,51],[79,51],[79,75],[132,75],[132,103],[32,103]],a,2);line(g,[[44,43],[142,43],[142,110]],'#e3eaf4',.8)}
 else{mapArt(g,8,9,164,112,a,type,t);if(type==='stack'||type==='plume'){const x=45,y=78;if(type==='stack'){rr(g,34,45,22,42,2,'#8295a1');rr(g,30,42,30,6,1,a)}for(let i=0;i<5;i++){g.beginPath();g.ellipse(x+17+i*20,y-7-i*6,17+i*5,6+i*5,-.32,0,TAU);g.fillStyle=`rgba(228,181,102,${.22-i*.027})`;g.fill();g.strokeStyle='#efc58d66';g.stroke()}}if(type==='layers'){for(let i=0;i<3;i++){g.beginPath();g.moveTo(33,85-i*18);g.lineTo(92,59-i*18);g.lineTo(145,78-i*18);g.lineTo(86,106-i*18);g.closePath();g.fillStyle=['#3b6b9477','#71a68b70','#d2c3a373'][i];g.fill();g.strokeStyle='#c3dfdd';g.stroke()}}}break;}
 case 'screen':case 'capture':case 'camera':case 'gallery':case 'optimize':{toolbar(type==='screen'?'업무 화면':type==='capture'?'영역 캡처':'이미지');for(let i=0;i<3;i++)rr(g,9+i*56,31,50,83,4,'#263946','#536c78');if(type==='gallery'||type==='optimize'){for(let i=0;i<3;i++){let x=13+i*56;dot(g,x+32,47,7,a);g.beginPath();g.moveTo(x,89);g.lineTo(x+15,61);g.lineTo(x+25,75);g.lineTo(x+35,57);g.lineTo(x+42,89);g.closePath();g.fillStyle='#7aab9c';g.fill();rr(g,x,100,36*(type==='optimize'?.55:1),4,2,a)}}else{rr(g,13,36,154,70,3,'#42647b');rows(g,23,46,56,4,'#b8c7d4');rr(g,93,46,60,45,3,'#6a8998');if(type==='capture'){g.setLineDash([5,4]);g.strokeStyle=a;g.lineWidth=2;g.strokeRect(75+Math.sin(t*1.4)*8,41,75,54);g.setLineDash([]);dot(g,151,89,4,'#fa937a')}if(type==='camera'){dot(g,89,70,25,'#101923');dot(g,89,70,17,'#6f9fbd');dot(g,89,70,8,'#162d41');}}break;}
 case 'folder':case 'dual':case 'cloud':{toolbar('파일 관리');for(let i=0;i<(type==='dual'?4:2);i++){let x=10+(i%2)*82,y=32+Math.floor(i/2)*44;rr(g,x,y,77,type==='dual'?40:80,4,'#253a48');for(let j=0;j<(type==='dual'?2:4);j++){rr(g,x+7,y+8+j*14,14,8,2,a);rr(g,x+25,y+10+j*14,43,3,1,'#829caa')}}if(type==='cloud'){g.fillStyle='#92cadd';[[-17,0,18],[0,-12,22],[20,0,17]].forEach(([dx,dy,r])=>dot(g,90+dx,69+dy,r,'#92cadd'));rr(g,55,67,70,22,10,'#92cadd');text(g,'CLOUD',90,80,10,'#1a3140','center',true)}break;}
 case 'phonesearch':case 'phonedownload':case 'phonepdf':{rr(g,48,4,84,122,12,'#425768','#bac6cb');rr(g,54,12,72,105,6,'#182732');rr(g,77,7,26,4,2,'#101820');text(g,'EIASS',90,30,11,a,'center',true);if(type==='phonepdf'){doc(g,66,35,48,73,'PDF',a)}else{rr(g,61,36,58,12,3,'#455c6a');rows(g,62,56,56,4,'#9bb5be');if(type==='phonedownload'){dot(g,90,87,13,a);line(g,[[90,79],[90,94],[85,89]],'#19303c',2)}}break;}
 case 'finance':case 'chart':case 'dashboard':{toolbar(type==='finance'?'계약·수금':type==='dashboard'?'사업 현황':'분석 결과');for(let i=0;i<3;i++){rr(g,9+i*55,29,51,24,4,'#2b4351');rr(g,16+i*55,36,25,4,2,a);rr(g,16+i*55,44,35,3,1,'#899eaa')}graph(g,12,64,156,54,a);break;}
 case 'calendar':{toolbar('일정');for(let y=0;y<4;y++)for(let x=0;x<7;x++)rr(g,10+x*23,31+y*22,19,18,3,(x+y*7)===12?'#7ebaa7':'#2c4252');break;}
 case 'network':case 'sources':case 'tools':{toolbar('자료 연결');const nodes=[[90,65],[31,43],[145,43],[34,102],[145,102]];nodes.slice(1).forEach(p=>line(g,[nodes[0],p],'#6f9fb6',1.3));nodes.forEach(([x,y],i)=>{rr(g,x-14,y-10,28,20,4,i===0?a:'#385b70','#8fa9b6');if(i)rows(g,x-8,y-4,16,1,'#b7c6ce');else dot(g,x,y,4,'#285063')});break;}
 case 'shield':case 'approve':case 'verify':case 'tests':case 'checklist':case 'practice':{toolbar(type==='shield'?'자료 보호':type==='approve'?'사용자 승인':type==='tests'?'품질 검수':'검토 목록');['입력','검토','결과'].forEach((s,i)=>{rr(g,10,31+i*28,160,24,4,'#263b48');check(22,43+i*28);text(g,s,36,47+i*28,10,'#dce9ec');rr(g,112,40+i*28,45,5,2,a)});if(type==='shield'){g.beginPath();g.moveTo(126,44);g.lineTo(159,34);g.lineTo(173,44);g.lineTo(169,81);g.lineTo(150,97);g.lineTo(130,81);g.closePath();g.fillStyle='#2a625c';g.fill();g.strokeStyle=a;g.stroke();line(g,[[141,64],[148,72],[160,56]],'#d3f2d9',3)}break;}
 case 'workflow':case 'install':case 'status':{toolbar(type==='status'?'개발 상태':'작업 흐름');['01','02','03'].forEach((s,i)=>{rr(g,10+i*56,47,48,45,6,i===Math.floor(t*.6)%3?'#456575':'#2d4452');text(g,s,34+i*56,74,14,a,'center',true);if(i<2)arrow(62+i*56,69)});if(type==='status'){text(g,'개발 중 / 중지',90,112,10,'#c4d0da','center')}break;}
 case 'scan':list(['캐시','임시 파일','휴지통'],'정리 후보');break;
 case 'search':case 'browser':list(['검색 조건','검색 결과 01','검색 결과 02'],type==='browser'?'웹 브라우저':'사업 검색');break;
 default:list(['입력','처리','출력']);}
}
// Layered interface plates use affine projection of a tilted plane and physically separate thickness faces.
function plate(g,x,y,w,h,skew,type,accent,t,label,active){g.save();g.translate(x,y);g.transform(1,skew*.65,-.075,1,0,0);g.shadowColor='#0009';g.shadowBlur=14;g.shadowOffsetY=8;rr(g,0,11,w,h,10,'#0b1016');g.shadowColor='transparent';rr(g,0,6,w,h,10,'#40515e','#738593');rr(g,0,0,w,h,10,'#1d303e',active?accent:'#7a929f');g.save();g.translate(9,9);g.scale((w-18)/180,(h-18)/130);art(g,type,accent,t);g.restore();g.restore();if(label)text(g,label,x+w/2-5,y+h+35,15,active?accent:'#bbc6d1','center',true);}
function workflow(g,route,t,thumb){let d=SCENES[route],types=specs[d[1]],colors=tone[d[6]],a=colors[0];const glow=g.createRadialGradient(450,294,20,450,295,440);glow.addColorStop(0,colors[2]+'55');glow.addColorStop(1,'#10151d00');g.fillStyle=glow;g.fillRect(0,0,900,600);
 // Fine architectural deck with actual perspective axes.
 g.save();g.globalAlpha=.50;for(let j=0;j<11;j++){line(g,[[80+j*74,478],[450+(j-5)*36,245]],'#56748b35');line(g,[[80+(j*17),478-j*17],[820-j*17,478-j*17]],'#56748b35')}g.restore();
 const active=Math.floor(t*.57)%types.length;let layout=types.length===4?[[100,100,235,165,-.065],[536,100,235,165,.065],[100,319,235,165,-.065],[536,319,235,165,.065]]:[[55,225,234,169,-.10],[329,105,244,181,-.025],[612,225,234,169,.10]];
 if(thumb){layout=types.length===4?layout:[[50,225,244,169,-.10],[324,105,254,181,-.025],[608,225,244,169,.10]]}
 const cent=layout.map(([x,y,w,h])=>[x+w/2,y+h/2]);let edges=types.length===4?[[0,1],[0,2],[1,3],[2,3]]:[[0,1],[1,2]];
 for(let i=0;i<edges.length;i++){let [j,k]=edges[i],[x,y]=cent[j],[X,Y]=cent[k];g.save();g.setLineDash([5,7]);line(g,[[x,y],[X,Y]],a+'88',2);g.restore();let f=(t*.28+i*.36)%1;dot(g,x+(X-x)*f,y+(Y-y)*f,5,a);}
 types.forEach((typ,i)=>{let [x,y,w,h,skew]=layout[i];let lab=types.length===4?(d[1]==='principles'?['실천','사용성','자료 보호','검증'][i]:['문서 작업','문서 편집','환경영향평가','웹 서비스'][i]):d[2+i];plate(g,x,y+Math.sin(t*1.2+i)*4,w,h,skew,typ,a,t,lab,i===active)});
 
}
/* R05: synthetic geographic datasets for explanatory 3D views; never actual user coordinates. */
function geoScene(g,route,t,thumb){
 const d=SCENES[route],kind=d[1].slice(4),a='#b9d9ca',green='#74b7a4',amber='#f4bc80',blue='#87c2e4';
 const bg=g.createRadialGradient(450,285,12,450,285,465);bg.addColorStop(0,'#35685685');bg.addColorStop(1,'#142f3200');g.fillStyle=bg;g.fillRect(0,0,900,600);
 let fade=0.5+0.5*Math.sin(t*1.6),ang=-.53+Math.sin(t*.30)*.072,cs=Math.cos(ang),sn=Math.sin(ang);
 // World-space orthographic/isometric terrain with height, camera yaw, depth ordering.
 function P(x,y,z=0){let u=x*cs-y*sn,v=x*sn+y*cs;return [443+u*1.48,315+v*.64-z*1.45]}
 function poly(pts,fill,stroke,w=1){g.beginPath();pts.forEach((p,i)=>i?g.lineTo(...p):g.moveTo(...p));g.closePath();if(fill){g.fillStyle=fill;g.fill()}if(stroke){g.strokeStyle=stroke;g.lineWidth=w;g.stroke()}}
 function patch(x,y,w,h,z,color,edge='#8db5b76b'){poly([P(x,y,z),P(x+w,y,z),P(x+w,y+h,z),P(x,y+h,z)],color,edge)}
 function pin(x,y,z,col=amber){let p=P(x,y,z),tip=[p[0],p[1]-31];g.strokeStyle=col;g.lineWidth=2;g.beginPath();g.moveTo(...p);g.lineTo(...tip);g.stroke();dot(g,...tip,5,col);dot(g,...p,3,col);}
 function mesh(mode,ox=0,oy=0,z0=0){const n=31,step=12,arr=[];function h(x,y){return 9+86*Math.exp(-((x+44)**2+(y+30)**2)/13000)+42*Math.exp(-((x-102)**2+(y-90)**2)/7000)+9*Math.sin(x*.028)*Math.cos(y*.025)}
 for(let j=0;j<n;j++)for(let i=0;i<n;i++){let x=-187+i*step,y=-187+j*step,ps=[[x,y],[x+step,y],[x+step,y+step],[x,y+step]];let hs=ps.map(([u,v])=>h(u,v));let val=hs.reduce((a,b)=>a+b,0)/4;let slope=Math.max(...hs)-Math.min(...hs);let sx=(hs[1]+hs[2]-hs[0]-hs[3])/(step*2),sy=(hs[2]+hs[3]-hs[0]-hs[1])/(step*2),grade=Math.atan(Math.hypot(sx,sy))*180/Math.PI,shade=(.72+.38*(.66*sx+.48*sy))/Math.sqrt(1+sx*sx+sy*sy);let c=mode==='slope'?`hsl(${Math.max(8,116-grade*3.1)} 44% ${Math.max(22,Math.min(67,38+grade*.62+shade*10))}%)`:`hsl(${158-val*.55} ${22+val*.16}% ${Math.max(22,Math.min(76,24+val*.37+shade*13))}%)`;arr.push({depth:(x+step/2)*sn+(y+step/2)*cs,ps:ps.map(([u,v],k)=>P(u+ox,v+oy,hs[k]+z0)),c});}
 arr.sort((a,b)=>a.depth-b.depth).forEach(o=>poly(o.ps,o.c,'#a4c4b31b',.45));
 if(mode==='terrain'){for(let k=0;k<3;k++){const x=-148+k*142;let v=P(x,-190,18+z0);text(g,'표고 '+(k+1),v[0],v[1]-5,12,a,'center')}}
 }
 function base(){let top=[P(-198,-198,0),P(198,-198,0),P(198,198,0),P(-198,198,0)],bot=[P(-198,-198,-17),P(198,-198,-17),P(198,198,-17),P(-198,198,-17)];poly([top[1],bot[1],bot[2],top[2]],'#243f49','#5f8588');poly([top[2],bot[2],bot[3],top[3]],'#14292d','#4e6d74');poly(top,'#1d3539','#668d8b');}
 function map(z=0,mode='normal'){patch(-187,-187,374,374,z,'#344b46');for(let i=0;i<10;i++){let x=-176+i*37;line(g,[P(x,-187,z+.5),P(x,187,z+.5)],'#a1c0af2a',.8);line(g,[P(-187,x,z+.5),P(187,x,z+.5)],'#a1c0af2a',.8)}
 // stream corridor and street network, deliberately fictional.
 let river=[];for(let i=0;i<=24;i++){let y=-187+i*15.58,x=-104+Math.sin(i*.34)*38;river.push(P(x,y,z+1))}line(g,river,'#5b97b5',12);line(g,river,'#9ac8db',1.5);
 [[[-180,-85],[178,20]],[[-15,-187],[22,187]],[[-180,120],[180,-110]]].forEach(l=>{const pts=l.map(p=>P(...p,z+2));line(g,pts,'#28353c',8);line(g,pts,'#bbbcac',4);});
 const colors=['#a8ceb8','#c4a58c','#87adcb','#b1b1d8','#d3c185'];for(let j=0;j<5;j++)for(let i=0;i<6;i++){let x=-160+i*54,y=-163+j*68;if((i+j)%5===0)continue;patch(x,y,18+(i%3)*4,20,z+3,mode==='color'?colors[(i+2*j+Math.floor(t*.4))%colors.length]:'#9fac997d','#b6cebd7a')}
 }
 function boundary(z=4){let pts=[[-70,-90],[84,-80],[120,25],[43,92],[-52,70]].map(p=>P(...p,z));poly(pts,'#dcaa5d27',amber,2.2);return pts}
 function circleWorld(x,y,r,z,color){let pts=Array.from({length:49},(_,i)=>P(x+r*Math.cos(i*TAU/48),y+r*Math.sin(i*TAU/48),z));line(g,pts,color,1.7)}
 function label(s,x,y,col=a){text(g,s,x,y,thumb?19:17,col,'center',true)}
 if(kind==='terrain'||kind==='slope'){base();mesh(kind==='terrain'?'terrain':'slope');if(kind==='slope'){boundary(103);const p=P(-40,-60,112);line(g,[p,[p[0]-84,p[1]-46]],amber,1.5);label('사업지구',p[0]-86,p[1]-53,amber);for(let i=0;i<5;i++)rr(g,310+i*56,480,55,10,1,`hsl(${110-i*25} 45% 50%)`);label('완만함  →  가파름',450,518)}else{label('다중 표고자료의 입체 지형',450,500)}}
 else if(kind==='onmap'){base();map();let z=100+Math.sin(t*1.1)*13;patch(-150,-150,300,300,z,'#a9c7c02d','#a6dfd9');for(let i=0;i<4;i++){let c=-150+i*100;line(g,[P(c,-150,z),P(c,150,z)],'#e2c283',1);line(g,[P(-150,c,z),P(150,c,z)],'#e2c283',1)}for(let [x,y] of [[-150,-150],[150,-150],[150,150],[-150,150]]){line(g,[P(x,y,z),P(x,y,1)],'#90bdebb0',1.4);dot(g,...P(x,y,z),4,amber)}label('온맵 PDF 도곽',450,90,amber);label('공식 도엽 정합 · GeoTIFF',450,500)}
 else if(kind==='designer'){base();map(6);for(let i=0;i<3;i++){let z=38+i*35+fade*9;patch(-165,-165,330,330,z,'#7aafae19','#a1c7c46a');if(i===0){line(g,[P(-150,45,z),P(150,-60,z)],'#ead5ae',4)}else if(i===1){for(let n=0;n<10;n++)patch(-140+(n%5)*65,-80+Math.floor(n/5)*90,25,22,z+1,'#b2ccbeaa')}else{let pts=Array.from({length:24},(_,n)=>P(-85+Math.sin(n*.25)*30,-160+n*13,z));line(g,pts,blue,7)}}label('도로 · 건물 · 수계 레이어',450,88,blue);label('벡터 지도 합성 · GeoPackage',450,515)}
 else if(kind==='catalogue'){const labels=['플러그인','스크립트','검색','즐겨찾기','진단','백업'];for(let i=0;i<6;i++){let x=115+(i%3)*230,y=135+Math.floor(i/3)*165,dy=Math.sin(t*1.1+i)*4;g.save();g.translate(x,y+dy);g.transform(1,-.07,-.10,1,0,0);rr(g,0,10,190,118,12,'#0a171e');rr(g,0,0,190,118,12,'#293f49',i===Math.floor(t*.8)%6?amber:'#789ca0');rr(g,18,17,40,36,7,'#609b91');if(i===1)text(g,'Py',38,41,15,'#fff','center',true);else{line(g,[[29,28],[47,42],[48,27]],'#f6e1b9',2)}text(g,labels[i],95,90,20,'#f3f6f5','center',true);g.restore()}label('한곳에서 검색 · 선택 · 실행',450,515)}
 else {base();map(0,kind==='color'?'color':'normal');if(kind==='protect'){boundary(4);poly([P(-145,-120,7),P(-5,-140,7),P(57,25,7),P(-125,50,7)],'#66bc8e52','#9be2b4',2);poly([P(65,-40,8),P(170,-55,8),P(147,125,8),P(67,110,8)],'#7aaddc51','#9ebde7',2);line(g,[P(90,20,11),P(148,75,11)],amber,2.5);label('보호구역 · 교차 · 이격거리',450,510)}
 else if(kind==='survey'){boundary(4);circleWorld(0,0,139,5,'#efbd8080');circleWorld(0,0,172,5,'#76bed3aa');[[-125,-104],[140,-80],[136,106],[-111,126],[-54,-159]].forEach(([x,y],i)=>pin(x,y,7,[amber,blue,green,'#c6afd8'][i%4]));label('항목별 조사거리 · 지점 분산',450,510)}
 else if(kind==='locator'){[[-130,28],[-42,-92],[79,85],[131,-76]].forEach(([x,y],i)=>{pin(x,y,7,i===Math.floor(t)%4?amber:blue);let p=P(x,y,7);text(g,'지점 '+(i+1),p[0]+10,p[1]-43,14,'#e9f1f2','left',true)});label('주소 · 위경도 · TM → 점 레이어',450,510)}
 else if(kind==='photo'){[[-118,-85],[40,28],[122,110]].forEach(([x,y],i)=>{pin(x,y,8,amber);let p=P(x,y,8),px=105+i*240,py=90+Math.sin(t+i)*6;line(g,[p,[px+70,py+88]],'#b3d7d6a0',1);rr(g,px,py,138,90,8,'#d8e6e3','#9ebbb8');rr(g,px+8,py+8,122,59,4,'#547f8b');poly([[px+8,py+64],[px+47,py+29],[px+77,py+55],[px+95,py+39],[px+130,py+66]],'#8fbaa2');dot(g,px+105,py+22,6,amber);text(g,'사진 '+(i+1),px+69,py+82,13,'#23414b','center',true)});label('시설별 사진 후보 연결 · 지도 검수',450,510)}
 else if(kind==='color'){for(let i=0;i<5;i++)rr(g,295+i*63,474,54,18,4,['#a8ceb8','#c4a58c','#87adcb','#b1b1d8','#d3c185'][(i+Math.floor(t*.4))%5]);label('점·선·면 심볼 미리보기',450,522)}
 else {boundary(5);[[-90,-70],[110,-90],[-130,90],[100,125]].forEach(([x,y])=>pin(x,y,6,amber));let z=73+fade*8;patch(-150,-150,300,300,z,'#a1c9d317','#94cddd77');label('공간자료 → 분석·설계 → 지도',450,510)}}
 
}

function drawScene(canvas,route,t,thumb=false,view=0){let g=canvas.getContext('2d');if(!g)return;let w=canvas.width,h=canvas.height;g.setTransform(w/900,0,0,h/600,0,0);g.clearRect(0,0,900,600);if(route==='/')solar(g,t,view);else if(SCENES[route][1].startsWith('geo:')){geoScene(g,route,t,thumb);}else{if(thumb){g.translate(-10,-56);g.scale(1.02,1.13);}workflow(g,route,t,thumb);}}
/* R15 offline texture cache; create GPU texture only after image decode. */
const R15_PLANET_DATA={"planet-earth":"data:image/jpeg;base64,