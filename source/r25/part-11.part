 return ()=>{disposed=true;stop();io.disconnect();ro.disconnect();button.removeEventListener('click',toggle);reduced.removeEventListener('change',setting);document.removeEventListener('visibilitychange',visibility);canvas.removeEventListener('webglcontextlost',lost);if(gpu)gpu.dispose();for(let im of decoded.values()){im.onload=null;im.onerror=null;}decoded.clear();lastImage=null;}
}

function setupCatalogue(){const input=outlet.querySelector('#product-search');if(!input)return;const groups=[...outlet.querySelectorAll('.catalog-group')], rows=[...outlet.querySelectorAll('.catalog-line')],count=outlet.querySelector('.r07-result'),empty=outlet.querySelector('.r07-no-results');function filter(){const terms=input.value.trim().toLocaleLowerCase('ko').split(/\s+/).filter(Boolean);let visible=0;rows.forEach(a=>{const stateQuery=input.value.replace(/\s+/g,'');const stateLabel=a.querySelector('.r08-state');const statusText=(stateLabel?.textContent||a.querySelector('.catalog-line-meta')?.textContent||'').replace(/\s+/g,'');const hit=['개발중','개발완료','개발중지'].includes(stateQuery)?(stateQuery==='개발중'?statusText.includes('개발중')&&!statusText.includes('개발중지'):statusText.includes(stateQuery)):terms.every(t=>a.textContent.toLocaleLowerCase('ko').includes(t));a.hidden=!hit;if(hit)visible++});groups.forEach(g=>g.hidden=!g.querySelector('.catalog-line:not([hidden])'));count.textContent=`${visible}개 / 전체 ${rows.length}개`;empty.hidden=visible!==0;}input.addEventListener('input',filter);outlet.querySelectorAll('.r07-category-link').forEach(a=>a.addEventListener('click',()=>{if(input.value){input.value='';filter()}}));filter()}
let hasRendered=false;
function decorate(){
 const route=outlet.dataset.route;
 outlet.querySelectorAll('[data-thumb]').forEach(c=>{const route=c.dataset.thumb;const row=c.closest('.catalog-line');const source=[...document.querySelectorAll('template[data-route]')].find(t=>t.dataset.route===route)?.content.querySelector('.project-screen img, .r12-hero-proof img');if(row&&source){const img=document.createElement('img');img.src=source.getAttribute('src');img.alt='';img.loading='lazy';img.decoding='async';row.classList.add('r07-real-preview');const label=document.createElement('small');label.className='r07-preview-label';label.textContent='실제 실행 화면';c.replaceWith(img,label);}else if(row){row.classList.add('r08-text-row');c.closest('.sg3-product-object')?.remove()}else{c.remove()}});
 const main=outlet.querySelector('main'); const detail=main?.querySelector('.project-detail-grid');if(detail){const blocks=[...detail.children].filter(n=>n.tagName==='DIV');if(blocks.length===2){blocks[0].classList.add('r17-release');blocks[1].classList.add('r17-features');detail.insertBefore(blocks[1],blocks[0]);}} setupCatalogue();
 const label=document.querySelector('.sg-location');if(label){const trail=label.parentElement;trail.querySelectorAll('.r16-crumb').forEach(n=>n.remove());const parents=route.startsWith('/projects/')?[['프로그램','#/programs'],main?.classList.contains('r05-qgis')?['QGIS 플러그인','#/programs/qgis']:['PC 프로그램','#/programs/pc']]:route.startsWith('/programs/')?[['프로그램','#/programs']]:['/philosophy','/future'].includes(route)?[['그룹 소개','#/about']]:[];for(const [name,href] of parents){const a=document.createElement('a');a.className='r16-crumb';a.href=href;a.textContent=name;const sep=document.createElement('span');sep.className='r16-crumb r16-separator';sep.setAttribute('aria-hidden','true');sep.textContent='/';trail.insertBefore(a,label);trail.insertBefore(sep,label);}}if(label)label.textContent=({"/":"홈","/about":"그룹 소개","/philosophy":"이념과 원칙","/programs":"프로그램","/programs/pc":"PC 프로그램","/programs/qgis":"QGIS 플러그인","/development":"개발 현황","/future":"앞으로의 방향","/help":"이용 안내"})[route]||outlet.querySelector('h1')?.textContent||'Sunrise Group';
}
function render(){const raw=location.hash.startsWith('#/')?location.hash.slice(1):'/';let [path,anchor]=raw.split('#');if(path==='/programs'&&anchor){const m={documents:'work',work:'work',editing:'editing',environment:'environment',web:'web'};if(m[anchor]){path='/programs/pc';anchor=m[anchor];}}const templates=[...document.querySelectorAll('template[data-route]')];const template=templates.find(t=>t.dataset.route===path)||templates.find(t=>t.dataset.route==='/');const changed=outlet.dataset.route!==template.dataset.route;
 if(changed){dispose();outlet.replaceChildren(template.content.cloneNode(true));outlet.dataset.route=template.dataset.route;decorate();document.title=template.dataset.route==='/'?'Sunrise Group':(outlet.querySelector('h1')?.textContent||'프로그램')+' | Sunrise Group';document.querySelectorAll('.desktop-nav a,.mobile-menu a').forEach(a=>{const projectParent=outlet.querySelector('.project-hero .sg3-hero-copy>a')?.getAttribute('href');const active=a.getAttribute('href')==='#'+template.dataset.route||(a.closest('.r11-group-nav')&&a.classList.contains('nav-card')&&['/about','/philosophy','/future'].includes(template.dataset.route))||((path.startsWith('/projects/')||path.startsWith('/programs/'))&&a.getAttribute('href')==='#/programs');if(active)a.setAttribute('aria-current','page');else a.removeAttribute('aria-current')});const cleanups=[...outlet.querySelectorAll('[data-scene]')].map(f=>f.dataset.scene==='/'?r23SolarRender(f):sg3Render(f));dispose=()=>cleanups.forEach(fn=>fn());}
 document.querySelector('.mobile-menu')?.removeAttribute('open'); closeProgramMenu(); if(anchor)requestAnimationFrame(()=>{const target=document.getElementById(anchor);if(target?.tagName==='DETAILS')target.open=true;target?.scrollIntoView();});else if(changed){window.scrollTo({top:0,behavior:'instant'});if(hasRendered){const main=outlet.querySelector('main');if(main){main.tabIndex=-1;main.focus({preventScroll:true});}}}hasRendered=true;
}
const menuToggles=[...document.querySelectorAll('.r07-nav-toggle')];function closeProgramMenu(except=null){menuToggles.forEach(toggle=>{if(toggle===except)return;const menu=document.getElementById(toggle.getAttribute('aria-controls'));if(menu)menu.hidden=true;toggle.setAttribute('aria-expanded','false')})}menuToggles.forEach(toggle=>{const menu=document.getElementById(toggle.getAttribute('aria-controls'));if(!menu)return;toggle.addEventListener('click',()=>{const opening=menu.hidden;closeProgramMenu(toggle);menu.hidden=!opening;toggle.setAttribute('aria-expanded',String(opening));});});document.addEventListener('click',e=>{if(e.target.closest('.r07-submenu a')||!e.target.closest('.r07-nav-program'))closeProgramMenu()});document.addEventListener('keydown',e=>{if(e.key==='Escape'){const open=menuToggles.find(t=>t.getAttribute('aria-expanded')==='true');if(open){closeProgramMenu();open.focus()}}});let progressQueued=false;function readProgress(){progressQueued=false;const range=document.documentElement.scrollHeight-innerHeight;document.querySelector(".sg-read-progress i")?.style.setProperty("width",`${range>0?Math.max(0,Math.min(100,scrollY/range*100)):0}%`);}function queueProgress(){if(!progressQueued){progressQueued=true;requestAnimationFrame(readProgress);}}window.addEventListener("scroll",queueProgress,{passive:true});window.addEventListener("resize",queueProgress);window.addEventListener('hashchange',()=>{render();queueProgress();});document.addEventListener('click',e=>{const link=e.target.closest('a');if(!link)return;if(link.getAttribute('href')==='#main'){e.preventDefault();const main=document.getElementById('main');if(main){main.tabIndex=-1;main.focus({preventScroll:true});main.scrollIntoView()}return}if(link.closest('.mobile-menu'))document.querySelector('.mobile-menu')?.removeAttribute('open');if(link.dataset.image==='true'){e.preventDefault();const [head,base64]=link.href.split(',');const bytes=Uint8Array.from(atob(base64),c=>c.charCodeAt(0));const url=URL.createObjectURL(new Blob([bytes],{type:head.slice(5).split(';')[0]}));window.open(url,'_blank','noopener');setTimeout(()=>URL.revokeObjectURL(url),60000)}});
document.addEventListener('keydown',e=>{if(e.key==='Escape'){const menu=document.querySelector('.mobile-menu[open]');if(menu){menu.removeAttribute('open');menu.querySelector('summary').focus()}}});render();queueProgress();
})();
</script><script id="sunrise-r21-motion">
(()=>{'use strict';
const root=document.getElementById('page-outlet'),pref=matchMedia('(prefers-reduced-motion: reduce)');let observer=null,chapterObserver=null,raf=0,home=null,nav=null;
function update(){raf=0;if(!home)return;const scene=home.querySelector('.r19-cinema');if(!scene)return;const paused=scene.querySelector('.sg3-pause')?.getAttribute('aria-pressed')==='true';const t=pref.matches||paused?0:Math.max(0,Math.min(1,-scene.getBoundingClientRect().top/Math.max(1,scene.offsetHeight)));home.style.setProperty('--r21-title-shift',(-t*18).toFixed(2)+'px');home.style.setProperty('--r21-space-scale',(1+t*.035).toFixed(4));}
function queue(){if(!raf&&home)raf=requestAnimationFrame(update)}
function setup(){observer?.disconnect();chapterObserver?.disconnect();home=null;nav=null;const main=root.querySelector('main');if(!main)return;if(!pref.matches){main.classList.add('r21-enter');main.addEventListener('animationend',()=>main.classList.remove('r21-enter'),{once:true});observer=new IntersectionObserver(entries=>{for(const e of entries)if(e.isIntersecting){const el=e.target;observer.unobserve(el);if(!pref.matches){el.classList.add('r21-reveal');el.addEventListener('animationend',()=>el.classList.remove('r21-reveal'),{once:true});}}},{threshold:.12});main.querySelectorAll('main > section:not(:first-child), .r20-feature-layout,.r19-workflow,.catalog-group').forEach(el=>observer.observe(el));}
if(root.dataset.route==='/'){home=main;const sections=[['purpose','그룹의 목표'],['r21-values','개발 이념'],['r21-future','미래 방향']];main.querySelector('.r19-values-section').id='r21-values';main.querySelector('.r19-end').id='r21-future';nav=document.createElement('nav');nav.className='r21-chapter-nav';nav.setAttribute('aria-label','메인 화면 목차');for(const [id,label] of sections){const a=document.createElement('a');a.href='#/#'+id;a.textContent=label;nav.append(a)}main.querySelector('.r19-cinema-links').append(nav);chapterObserver=new IntersectionObserver(es=>{for(const e of es)if(e.isIntersecting){nav?.querySelectorAll('a').forEach(a=>{if(a.hash==='#/#'+e.target.id)a.setAttribute('aria-current','location');else a.removeAttribute('aria-current')})}},{rootMargin:'-15% 0px -50% 0px'});sections.forEach(([id])=>chapterObserver.observe(document.getElementById(id)));queue();}}
new MutationObserver(records=>{if(records.some(r=>r.target===root))setup()}).observe(root,{childList:true});window.addEventListener('scroll',queue,{passive:true});window.addEventListener('resize',queue,{passive:true});pref.addEventListener('change',()=>{root.querySelectorAll('.r21-enter,.r21-reveal').forEach(el=>el.classList.remove('r21-enter','r21-reveal'));queue()});root.addEventListener('click',e=>{if(e.target.closest('.sg3-pause'))queue()});setup();
})();
</script>
<script id="sunrise-r22-scene-label">(()=>{'use strict';const root=document.getElementById('page-outlet');if(!root)return;function sync(){for(const f of root.querySelectorAll('figure[data-scene]')){const label=f.querySelector('.r22-render-mode');if(!label)continue;const mode=f.dataset.renderer;const text=mode==='solar-projection'?'인터랙티브 호환 3D':mode==='webgl2-pbr'?(f.dataset.scene==='/'?'실시간 WebGL2':'실시간 3D'):mode==='native-frames'?'렌더링 미리보기':mode==='semantic-canvas'?'호환 모션':'그래픽 준비 중';if(label.textContent!==text)label.textContent=text;}}new MutationObserver(sync).observe(root,{childList:true,subtree:true,attributes:true,attributeFilter:['data-renderer']});sync();})();</script>
</body></html>