 function paint(){if(disposed)return;if(route==='/'&&!paused){let target=Math.max(0,Math.min(1,window.scrollY/(innerHeight*.75)));cameraView+=(target-cameraView)*.12}figure.dataset.cameraView=cameraView.toFixed(3);if(gpu){try{let start=performance.now();gpu.paint(phase,cameraView);figure.dataset.frameReady='true';let dt=performance.now()-start;if(!paused){slow=dt>28?slow+1:Math.max(0,slow-1);if(slow>=12&&quality>.62){quality=Math.max(.60,quality*.82);slow=0;resize(false);}}}catch(e){useFallback('webgl2-draw: '+String(e.message||e).slice(0,180),true);fallbackPaint();}}else fallbackPaint();}
 function resize(draw=true){const w=canvas.getBoundingClientRect().width;if(w<1)return;const dpr=Math.min(devicePixelRatio||1,gpu?1.7:1.5),pixels=Math.min(gpu?1500:900,Math.max(gpu?420:320,Math.round(w*dpr*quality))),h=Math.round(pixels*2/3);if(canvas.width!==pixels||canvas.height!==h){canvas.width=pixels;canvas.height=h;if(draw)paint();}}
