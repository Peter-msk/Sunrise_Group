function sg3Render(figure){
 let canvas=figure.querySelector('canvas'),button=figure.querySelector('button'),route=figure.dataset.scene,phase=0,last=0,raf=0,paused=motionChoice??reduced.matches,visible=true,disposed=false,cameraView=0,gpu=null,ro=null,backend='',quality=1,slow=0;
 const frames=R13_FRAMES[route]||[],decoded=new Map();let lastImage=null,loadFailure=false;
 function mode(type,reason=''){backend=type;figure.dataset.renderer=type;figure.dataset.renderReason=reason;figure.querySelector('figcaption').title=type==='webgl2-pbr'?'실시간 WebGL2 HDR 입체 렌더링':type==='native-frames'?'고해상도 사전 렌더링 장면 · 그래픽 호환 모드':'Canvas 기반 호환 모션';button.title=figure.querySelector('figcaption').title;}
