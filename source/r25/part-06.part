const solarBodies=[
 ['sun','태양','Sunrise Group',0,1.52,0,0,'#ffad52',1,0],
 ['rock','수성','실무 기반',2.48,.17,.38,2.78,'#aaa095',2,.01],
 ['venus','금성','사용 경험',3.58,.29,.24,5.68,'#e2c49a',2,.03],
 ['earth','지구','환경 평가',4.86,.31,.18,1.08,'#80bcd6',3,.0],
 ['mars','화성','개선 역량',6.06,.23,.135,4.02,'#c77b53',4,.025],
 ['jupiter','목성','PC 솔루션',8.18,.82,.073,.42,'#d3b38d',5,.015],
 ['saturn','토성','보안 신뢰',10.28,.69,.052,2.18,'#e2d1a2',5,.025],
 ['uranus','천왕성','공간 정보',12.38,.43,.032,5.04,'#91cbd2',5,.01],
 ['neptune','해왕성','확장 비전',14.16,.42,.024,3.08,'#719be9',5,.018]
