 let k=SCENES[route][1].slice(4),terrainMode=k==='terrain'||k==='slope';eye=[6.9+Math.sin(t*.28)*.28,6.55,9.05];target=[0,.45,0];ambient=.93;
 B([0,-.27,0],[6.18,.43,5.58],mats.dark);B([0,-.045,0],[6.03,.055,5.43],mats.metal);flat(terrainMode?(k==='slope'?terrainB:terrainA):mapmesh,[0,0,0],material('#ffffff',.035,.83,8));
