 else if(k==='color'){let cols=['#b3d9c4','#ddaa83','#8faacb','#bba6d0','#d4c27c'];for(let j=0;j<5;j++)for(let i=0;i<6;i++){if((i+j)%5===0)continue;B([-2.48+i*.9,.055,-2.13+j*.98],[.48+(i%3)*.07,.08,.48],material(cols[(i+j+Math.floor(t*.5))%5],.05,.63))}}
