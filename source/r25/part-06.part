 if(terrainMode){if(k==='slope'){let pts=boundaryPts.map(([x,y,z])=>[x,hfun(x,z)+.05,z]);linePts('terrain-boundary',pts,'#f2c28a',.025)}else{for(let i=0;i<3;i++){let x=-2.92+i*2.92;linePts('dem-divide'+i,Array.from({length:80},(_,j)=>{let z=-2.64+j*5.28/79;return [x,hfun(x,z)+.012,z]}),'#d3d6b6',.012)}}for(let i=0;i<3;i++){let x=-1.5+i*1.4,z=.55*Math.sin(i*2);pin(x,z,'#add6d7',i,hfun(x,z))}}
 else if(k==='designer'||k==='onmap'){
 let n=k==='designer'?3:1;for(let i=0;i<n;i++){let y=.58+i*.63+.06*Math.sin(t*.9+i);B([0,y-.035,0],[5.6,.045,4.9],material('#97b8ae',.05,.3,0,0,.16));if(k==='onmap'){flat(mapmesh,[0,y,0],material('#ffffff',0,.62,8,0,.84),[.92,1,.92]);for(let j of [-2.68,2.68])for(let z of [-2.35,2.35]){C([j,y*.5,z],[.025,y,.025],mats.gold);S([j,y+.045,z],.075,mats.gold)}}else if(i===0){let pts=[[-2.6,y+.04,-1.2],[-1.2,y+.04,-.5],[.6,y+.04,.2],[2.6,y+.04,1.1]];for(let j=0;j<pts.length-1;j++){let a=pts[j],b=pts[j+1],dx=b[0]-a[0],dz=b[2]-a[2];B([(a[0]+b[0])/2,y+.04,(a[2]+b[2])/2],[Math.hypot(dx,dz),.045,.09],mats.gold,[0,-Math.atan2(dz,dx),0])}}else if(i===1){for(let j=0;j<13;j++)B([-2.3+(j%5)*1.08,y+.10,-1.85+Math.floor(j/5)*1.5],[.44,.16,.34],mats.paper)}else{for(let j=0;j<riverPts.length-1;j+=4){let a=riverPts[j],b=riverPts[Math.min(j+4,riverPts.length-1)],dx=b[0]-a[0],dz=b[2]-a[2];B([(a[0]+b[0])/2,y+.04,(a[2]+b[2])/2],[Math.hypot(dx,dz),.03,.22],mats.blue,[0,-Math.atan2(dz,dx),0])}}}
 }else if(k==='protect'){flat(protectedA,[0,.046,0],material('#8dd5a2',0,.62,0,0,.63));flat(protectedB,[0,.05,0],material('#8fc9dc',0,.62,0,0,.65));flat(projectPoly,[0,.082,0],material('#f0be73',0,.55,0,0,.46));flat(boundary,[0,.055,0],mats.gold);linePts('separation',[[1.45,.14,.25],[2.35,.14,1.85]],'#ffcb79',.037);pin(1.45,.25,'#f4ca87');pin(2.35,1.85,'#f4ca87',1)}
