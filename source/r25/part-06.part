}

function scene(route,t,view=0,aspect=1.5){let list=[],home=route==='/',geo=SCENES[route][1].startsWith('geo:');const add=(mesh,p,s,m,r=[0,0,0],tex='')=>list.push({mesh,matrix:model(p,s,r),mat:m,tex});const B=(p,s,m,r)=>add(box,p,s,m,r);const P=(p,s,m,r,tex)=>add(front,p,s,m,r,tex);const S=(p,r,m)=>add(r<.15?markerSphere:sphere,p,[r,r,r],m);const C=(p,s,m,r)=>add(cyl,p,s,m,r);const flat=(mesh,p,m,s=[1,1,1],r=[0,0,0])=>add(mesh,p,s,m,r);let eye,target,light=[-4.3,7.8,5.0],ambient=1;
