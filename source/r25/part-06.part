function tube(key,pts,r=.025,closed=false){return geometry(key,()=>{let v=[],idx=[],n=pts.length;for(let i=0;i<n;i++){let p=pts[i],t=norm(sub(pts[Math.min(n-1,i+1)],pts[Math.max(0,i-1)])),x=norm(cross(t,Math.abs(t[1])>.9?[1,0,0]:[0,1,0])),y=cross(t,x);for(let j=0;j<=8;j++){let a=j*T/8,nn=x.map((q,k)=>q*Math.cos(a)+y[k]*Math.sin(a)),q=p.map((q,k)=>q+r*nn[k]);v.push(...q,...nn,i/(n-1),j/8,1,1,1)}}for(let i=0;i<n-1;i++)for(let j=0;j<8;j++){let a=i*9+j,b=a+9;idx.push(a,b,a+1,a+1,b,b+1)}return {v,idx}})}
