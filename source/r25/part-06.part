function solarState(t,view,aspect){
 let c=typeof view==='object'&&view?view:{};let yaw=c.yaw??-.12,pitch=c.pitch??-.60,roll=c.roll??-.06;
 let orientation=mul(ry(yaw),mul(rx(pitch),rz(roll))),right=orientation.slice(0,3),up=orientation.slice(4,7),back=orientation.slice(8,11);
 let target=c.target||[0,0,0],dist=Math.max(31,44/aspect)*(c.zoom??1),eye=target.map((v,i)=>v+back[i]*dist);
 let camera=mul(persp(34*PI/180,aspect,.15,170),look(eye,target,up));
 let bodies=solarBodies.map(p=>{let a=p.phase+t*p.speed;let pos=[p.orbit*Math.cos(a),p.orbit*Math.sin(a)*Math.sin(p.tilt),p.orbit*Math.sin(a)*Math.cos(p.tilt)];return {...p,pos}});
